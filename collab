    if not path.exists():
        return False
    path.unlink(missing_ok=True)
    people = people_ids(config)
    return not team_of(config) and all(p["id"] in people for p in config["participants"])


def room_is_empty(config: dict[str, Any]) -> bool:
    people = people_ids(config)
    return all(p["id"] in people for p in config["participants"])


AGENT_FIELDS = {
    "role": lambda: tr("Role"),
    "topic": lambda: tr("Topic"),
    "use_model": lambda: tr("Model"),
    "context_trim": lambda: tr("Memory"),
    "reports_to": lambda: tr("Reports to"),
}
ROOM_FIELDS = {
    "lead": lambda: tr("Lead"),
    "goal": lambda: tr("Goal"),
    "round": lambda: tr("Lead's rounds"),
    "output": lambda: tr("Result file"),
    "without_person": lambda: tr("Without you"),
}
MODELS = {"claude": ["opus", "sonnet", "haiku"], "codex": []}


def field_title(key: str) -> str:
    """A field's name, in the chat's language when it is shown."""
    return (ROOM_FIELDS | AGENT_FIELDS)[key]()


def open_team_menu(ctx: ChatCommandContext, cfg: dict[str, Any]) -> None:
    """/team on a running team: change an agent, the room's settings, or look back and undo."""
    agents = agents_of(cfg)
    waiting = pending_proposals(read_messages())
    ctx.wizard.update(
        step="team_menu",
        from_cmd="/team",
        prompt=tr("Change the team?"),
        options=[
            (tr("Proposal: {p0}", p0=proposal_words(cfg, m["proposal"])), f"proposal:{m['id']}") for m in waiting
        ]
        + [(tr("Change {p0}…", p0=visible(p.get("label") or p["id"])), f"agent:{p['id']}") for p in agents]
        + [
            (tr("The room: lead, goal, result file, what is done without you…"), "room"),
            (tr("Changes — look back, undo…"), "history"),
        ]
        + ([(tr("Save as your own scenario…"), "save")] if agents else [])
        + (
            [(tr("Continue the lead's rounds"), "rounds")]
            if "reached" in read_json(rounds_path())
            else []
        ),
    )


def setting_shown(key: str, value: object, cfg: dict[str, Any]) -> str:
    if value is None:
        return "default"
    if key == "context_trim":
        return memory_words(value)
    if key in ("reports_to", "lead"):
        return whom(str(value), cfg)
    if key == "without_person":
        return "; ".join(WITHOUT_PERSON[a] for a in cast("list[str]", value)) or tr("nothing external")
    return visible(str(value))


def when_words(cfg: dict[str, Any], who: str, key: str) -> str:
    """When a change starts to act — said before it is saved."""
    if who == "room":
        return tr("The agents get it with their next assignment.")
    if key == "use_model":
        # Not /model: Claude saves it as the person's own default for every new session.
        return tr(
            "A model takes effect when the program starts: /restart {p0} — its conversation goes on.",
            p0=label_of(cfg, who),
        )
    if key == "context_trim":
        return tr("From its next free minute; what it remembers now is not cut by this.")
    return tr("It gets its new assignment after its current task.")


def field_options(cfg: dict[str, Any], who: str, key: str) -> list[tuple[str, str]]:
    """The values to choose from for one field; «the default» takes the explicit one away."""
    if who == "room":
        if key == "lead":
            return [(visible(p.get("label") or p["id"]), p["id"]) for p in agents_of(cfg)]
        if key == "round":
            return [
                (tr("Every 15 minutes"), "15"),
                (tr("Every 30 minutes"), "30"),
                (tr("Every hour"), "60"),
                (tr("Off"), "off"),
            ]
        if key == "without_person":
            on = without_person(cfg)
            return [
                (tr("{p0} {words}", p0="✓" if a in on else "·", words=words), f"toggle:{a}")
                for a, words in WITHOUT_PERSON.items()
            ]
        return [(tr("Type it…"), "type"), (tr("None"), "default")]
    p = next(q for q in cfg["participants"] if q["id"] == who)
    kind = agent_kind(p)
    if key == "role":
        rows = [(tr("{r} — {words}", r=r, words=words), r) for r, words in ROLES.items()]
    elif key == "use_model":
        rows = [(name, name) for name in MODELS.get(kind, [])] + [(tr("Another model — type its name…"), "type")]
    elif key == "context_trim":
        rows = [
            (tr("Compact past 150k"), "compact"),
            (tr("Clear after handing in work"), "clear"),
            (tr("Keep — leave it to the program"), "keep"),
        ]
    elif key == "reports_to":
        rows = [(tr("The person"), "person")] + [
            (visible(q.get("label") or q["id"]), q["id"]) for q in agents_of(cfg) if q["id"] != who
        ]
    else:
        rows = [(tr("Type it…"), "type")]
    return rows + [(tr("The default — the scenario's, or the room's"), "default")]


def chosen_value(key: str, value: str, cfg: dict[str, Any]) -> object:
    if value == "default":
        return None
    if key == "context_trim":
        return MEMORY[value]
    if key == "round":
        return False if value == "off" else int(value)
    if key == "without_person":
        on = without_person(cfg)
        a = value.partition(":")[2]
        return [x for x in WITHOUT_PERSON if (x in on) != (x == a)]
    return value


def team_step(ctx: ChatCommandContext, line: str, say_: Callable[[str], None]) -> None:
    """/team's steps: an agent or the room → a field → a value → «before → after» and when it acts → Save."""
    step_ = ctx.wizard.get("step")
    cfg = load_config()
    if step_ == "team_menu" and line == "rounds":
        ctx.wizard.clear()
        state = read_json(rounds_path())
        state.pop("reached", None)
        write_json(rounds_path(), state)
        say_(tr("The lead's rounds go on."))
        return
    if step_ == "team_menu" and line == "save":
        ctx.wizard.update(
            step="team_save", options=None, prompt=tr("A name for this team (letters, digits, - and _; Esc to go back):")
        )
        say_(ctx.wizard["prompt"])
        return
    if step_ == "team_save":
        name = line.strip()
        if not OWN_NAME.fullmatch(name):
            say_(tr("! A name of letters, digits, - and _, up to 40. Try again."))
            return
        scenario = team_to_scenario(cfg, name)
        why = scenario_problems(scenario, list(PRESETS))
        if why:
            ctx.wizard.clear()
            say_(tr("! Not saved: {why}.", why=clean_field("; ".join(why), 200)))
            return
        exists = own_scenario_path(name).exists()
        ctx.wizard.update(
            step="team_save_confirm",
            name=name,
            scenario=scenario,
            prompt=tr("Replace your scenario «{name}»?", name=name) if exists else tr("Save it?"),
            options=[(tr("Save"), "go"), (tr("Cancel"), "back")],
        )
        rows = [
            seat_line(
                seat["kind"],
                {"id": seat["seat"], **seat},
                {"participants": [{"id": x["seat"], **x} for x in scenario["seats"]], "team": scenario},
            )
            for seat in scenario["seats"]
        ]
        say_(
            tr("Your scenario «{name}»: the roles and settings, not the conversations, folders or history.", name=name)
            + "\n"
            + "\n".join("  " + visible(r) for r in rows)
            + "\n" * 4
        )
        return
    if step_ == "team_save_confirm":
        if line != "go":
            ctx.wizard_back()
            return
        name, scenario = ctx.wizard["name"], ctx.wizard["scenario"]
        ctx.wizard.clear()
        try:
            save_own_scenario(name, scenario)
        except (OSError, ValueError) as exc:
            say_(tr("! Not saved: {why}.", why=clean_field(str(exc), 200)))
            return
        say_(tr("Saved as your scenario «{name}»: a new room offers it in «What will we do?».", name=name))
        return
    if step_ == "team_menu":
        if line.startswith("proposal:"):
            m = next((x for x in read_messages() if x.get("id") == line.partition(":")[2]), None)
            if m is not None:
                ctx.wizard.clear()
                ctx.wizard.update(proposal_card(m, cfg))
            return
        if line == "history":
            records = read_changes()[-10:]
            if not records:
                say_(tr("No changes yet."))
                return
            ctx.wizard.update(
                step="team_history",
                prompt=tr("Undo a change?"),
                options=[
                    (
                        tr("{p0} · {p1}", p0=local_hm(r.get("at", "")), p1=change_words(cfg, r)),
                        f"undo:{r['id']}",
                    )
                    for r in reversed(records)
                ],
            )
            return
        who = "room" if line == "room" else line.partition(":")[2]
        fields = ROOM_FIELDS if who == "room" else AGENT_FIELDS
        if who != "room" and who not in ids_of(cfg):
            return
        rows = []
        for key, title_of in fields.items():
            title = title_of()
            if who == "room":
                value: object = lead_of(cfg) if key == "lead" else team_of(cfg).get(key)
            else:
                p = next(q for q in cfg["participants"] if q["id"] == who)
                value = effective(agent_kind(p), p, cfg, key)
                if key == "reports_to":
                    value = reports_to(agent_kind(p), p, cfg)
            own = who == "room" or key in next(q for q in cfg["participants"] if q["id"] == who)
            rows.append(
                (
                    tr(
                        "{title}: {p1}{p2}",
                        title=title,
                        p1=setting_shown(key, value, cfg),
                        p2="" if own else tr(" (the scenario’s)"),
                    ),
                    f"field:{key}",
                )
            )
        name = tr("the room") if who == "room" else label_of(cfg, who)
        ctx.wizard.update(step="team_card", who=who, prompt=tr("Change {name}: which?", name=name), options=rows)
        return
    if step_ == "team_history":
        rec_id = line.partition(":")[2]
        rec = next((r for r in read_changes() if r.get("id") == rec_id), None)
        if rec is None:
            return
        ctx.wizard.update(
            step="team_undo",
            record=rec_id,
            prompt=tr("Undo it?"),
            options=[(tr("Undo"), "go"), (tr("Cancel"), "back")],
        )
        say_(
            tr(
                "Undo: {p0}. Work done and money spent stay; history cleared from an agent does not come back.",
                p0=change_words(cfg, rec),
            )
            + "\n" * 4
        )
        return
    if step_ == "team_undo":
        if line != "go":
            ctx.wizard_back()
            return
        rec_id = ctx.wizard["record"]
        ctx.wizard.clear()
        try:
            rec, left = undo_changes(rec_id, ctx.args.as_)
        except ValueError as exc:
            say_(tr("! Not undone: {p0}.", p0=clean_field(str(exc), 200)))
            return
        if rec["changes"]:
            say_(tr("Undone: {p0}.", p0=change_words(load_config(), rec)))
        for why in left:
            say_(tr("! Left as it is: {why}.", why=why))
        return
    if step_ == "team_card":
        key = line.partition(":")[2]
        ctx.wizard.update(
            step="team_field",
            key=key,
            prompt=f"{field_title(key)}:",
            options=field_options(cfg, ctx.wizard["who"], key),
        )
        return
    if step_ in ("team_field", "team_typed"):
        who, key = ctx.wizard["who"], ctx.wizard["key"]
        if step_ == "team_field" and line == "type":
            ctx.wizard.update(step="team_typed", options=None, prompt=tr("{p0} (Esc to go back):", p0=field_title(key)))
            say_(ctx.wizard["prompt"])
            return
        after = line if step_ == "team_typed" else chosen_value(key, line, cfg)
        lead = lead_of(cfg)
        if who != "room" and key == "role" and after == "lead" and who != lead:
            # «Lead» for another agent is the room's change of lead — the one way a team keeps one lead: the new one
            # leads, the one before becomes a worker, in one record (it asked the same question again, unsaid why).
            who, key, after = "room", "lead", who
        elif who != "room" and key == "role" and who == lead and after != "lead":
            # The lead itself: no team is left without one — said, and back to its card, never the same question.
            ctx.wizard_back()
            ctx.wizard["went_back"] = True  # the history as wizard_back left it: Esc from the card goes on back
            say_(
                tr(
                    "! {name} leads the room: to give the lead to another, choose «lead» in that agent's card.",
                    name=label_of(cfg, who),
                )
            )  # above the card's menu by the one rule (chat_run_wizard_step)
            return
        why = change_problem(cfg, who, key, after)
        if why:
            say_(
                tr("! {why}. Try again.", why=why) + "\n" * (len(ctx.wizard.get("options") or []) + 2)
            )  # above the menu still open
            return
        before = explicit_value(cfg, who, key)
        if who == "room" and key == "lead":
            before = lead_of(cfg) or None  # who leads now, set or found by role
        elif who != "room":
            # What acts now, its own or its seat's — «default» said sonnet was nothing.
            p = next(q for q in cfg["participants"] if q["id"] == who)
            kind = agent_kind(p)
            before = reports_to(kind, p, cfg) if key == "reports_to" else effective(kind, p, cfg, key)
        changes = [{"who": who, "key": key, "after": after}]
        if who == "room" and key == "lead":
            # One lead: the new one takes the role, the one before becomes a worker — in one record.
            old = lead_of(cfg)
            changes += [{"who": str(after), "key": "role", "after": "lead"}]
            changes += [{"who": old, "key": "role", "after": "worker"}] if old and old != after else []
        ctx.wizard.update(
            step="team_confirm",
            changes=changes,
            prompt=tr("Save it?"),
            options=[(tr("Save"), "go"), (tr("Cancel"), "back")],
        )
        name = tr("the room") if who == "room" else label_of(cfg, who)
        say_(
            tr(
                "{name} — {p1}: {p2} → {p3}. ",
                name=name,
                p1=field_title(key).lower(),
                p2=setting_shown(key, before, cfg),
                p3=setting_shown(key, after, cfg),
            )
            + when_words(cfg, who, key)
            + "\n" * 4  # room for the choice under it
        )
        return
    if step_ == "team_confirm":
        if line != "go":
            ctx.wizard_back()
            return
        changes = ctx.wizard["changes"]
        ctx.wizard.clear()
        try:
            rec, _ = apply_changes(changes, ctx.args.as_)
        except ValueError as exc:
            say_(tr("! Not saved: {exc}.", exc=exc))
            return
        say_(tr("Saved: {p0}.", p0=change_words(load_config(), rec)))
        return


def chat_run_wizard_step(ctx: ChatCommandContext, line: str) -> None:
    """One step of a question, and one rule for what it said: a line printed while a menu is open goes above the menu,
    never under it — a refusal under the menu was covered by it, and the same question looked asked again unsaid."""
    said: list[str] = []
    wizard_step(ctx, line, said)
    rows = len(ctx.wizard.get("options") or []) + 2 if ctx.wizard.get("options") else 0
    if said and rows:
        # The feed's last lines are what the menu covers: blank ones as many as it takes, minus those said already.
        blank = len(said[-1]) - len(said[-1].rstrip("\n"))
        if blank < rows:
            ctx.feed("\n" * (rows - blank - 1))


def wizard_step(ctx: ChatCommandContext, line: str, said: list[str]) -> None:
    """/add, /remove, /mute, /name, /exit and the others: every answer is chosen in the menu;
    only what has to be written — a name, a path as the last resort — is typed."""
    rp = room().paths
    say_ = lambda text: (said.append(text), ctx.feed(paint(text, "38;5;252")))[1]
    if line in ("/exit", "/quit"):
        ctx.wizard.clear()
        ctx.wizard.update(
            step="exit_confirm",
            from_cmd="/exit",
            prompt=tr("Close chat? Agents keep running"),
            options=[(tr("No"), "n"), (tr("Yes"), "y")],
        )
        return
    if line in ("/mute", "/unmute", "/unlimit"):
        ctx.wizard.clear()
        people = ctx.people_for(line)
        if not people:
            say_(
                {
                    "/mute": tr("No one to mute."),
                    "/unmute": tr("No one is muted."),
                    "/unlimit": tr("No one is out of its limit."),
                }[line]
            )
            return
        prompt = {
            "/mute": tr("Mute whom? The room stops sending them messages"),
            "/unmute": tr("Unmute whom?"),
            "/unlimit": tr("Whose limit is over? The room sends its messages again"),
        }[line]
        ctx.wizard.update(
            step="mute_pick",
            verb=line,
            from_cmd=line,
            prompt=prompt,
            options=[(label_of(ctx.config, x), x) for x in people],
        )
        return
    if line == "/name":
        ctx.wizard.clear()
        ctx.wizard.update(
            step="name_pick",
            from_cmd="/name",
            prompt=tr("Rename whom?"),
            options=[(label_of(ctx.config, x) + (" (you)" if x == ctx.args.as_ else ""), x) for x in ctx.known],
        )
        return
    if line.startswith("/remove "):
        pid = ctx.names.get(line[len("/remove ") :].strip().lower().lstrip("@"))
        if not pid or pid in ("all", ctx.args.as_):
            say_(tr("Choose someone from the list."))
            return
        ctx.wizard.clear()
        ctx.wizard.update(
            step="rm_confirm",
            pid=pid,
            options=[(tr("No"), "n"), (tr("Yes, disconnect"), "y")],
            prompt=tr("Disconnect {p0}?", p0=label_of(ctx.config, pid)),
            from_cmd="/remove-name",
        )
        say_(
            tr(
                "Disconnect {p0}? Room messages will stop. The agent will keep running.", p0=label_of(ctx.config, pid)
            )
        )
        return
    if line == "/remove":
        people = [pid for pid in ctx.known if pid != ctx.args.as_]
        if not people:
            say_(tr("No one to disconnect."))
            return
        ctx.wizard.clear()
        ctx.wizard.update(
            step="rm_pick",
            people=people,
            from_cmd="/remove",
            options=[(label_of(ctx.config, x), str(i)) for i, x in enumerate(people, 1)],
        )
        ctx.wizard["prompt"] = tr("Choose an agent to disconnect")
        say_(ctx.wizard["prompt"] + ".")
        return
    if line == "/help":
        ctx.wizard.clear()
        cfg = load_config()
        paused, lang = cfg.get("paused"), room_language(cfg)
        options = []
        for key, title, _, _, _ in ctx.help_tasks:
            if key == "pause":
                title = "Resume the room" if paused else "Pause the room"  # English: help_words says it in the room's language
            options.append((help_words(title, lang), key))
        ctx.wizard.update(
            step="help_pick", from_cmd="/help", prompt=help_words("What would you like to do?", lang), options=options
        )
        return
    if line in ("/restart", "/add") and ctx.stale_chat():
        # Old code in memory would start the agent with yesterday's rule — a new Codex then asked
        # the person for every answer. Reopening the chat runs the new.
        ctx.wizard.clear()
        ctx.feed(paint("! " + ctx.stale_notice, "1;38;5;196"))
        return
    if line == "/dm" or line.startswith("/dm "):
        # Private talks in a panel beside the chat.
        arg = line[3:].strip()
        if arg == "close":
            ctx.close_dm()
            say_(tr("The private-talk panel is closed."))
            return
        if arg:
            pid = ctx.names.get(arg.lower().lstrip("@"))
            if not pid or pid in ("all", ctx.args.as_):
                say_(tr("Choose someone from the list."))
                return
            ctx.open_dm(pid)
            return
        ctx.wizard.clear()
        cfg = load_config()
        others = [q["id"] for q in cfg["participants"] if q["id"] != ctx.args.as_]
        if not others:
            say_(tr("No agents in the room yet. Add one with /add."))
            return
        ctx.wizard.update(
            step="dm_pick",
            from_cmd="/dm",
            prompt=tr("Talk privately with whom?"),
            options=[(label_of(cfg, x), x) for x in others],
        )
        return
    if line == "/mine":
        ctx.wizard.clear()
        cfg = load_config()
        st = read_status()
        waiting = [
            (
                tr(
                    "‼ {p0} waits for you: {p1}",
                    p0=label_of(cfg, pid),
                    p1=clean_field(x.get("detail", ""), 60) or "needs your input",
                ),
                "agent:" + pid,
            )
            for pid, x in st.items()
            if pid != ctx.args.as_ and pid in ids_of(cfg) and x.get("state") == "needs_owner"
        ]
        everything = read_messages()
        read = read_set(rp.receipts_dir, ctx.args.as_)
        unread = [m for m in for_person(everything, ctx.args.as_) if m["id"] not in read]
        # «Messages for you: unread and recent history» — it opens
        # always; Enter says where it leads; below the new, the last twenty already read.
        agents = set(ids_of(cfg)) - set(people_ids(cfg))

        def row(m: dict[str, Any], kind: str) -> tuple[str, str]:
            first = clean_field(visible(m["text"]).splitlines()[0] if m["text"].strip() else "", 50)
            where = tr("Open conversation") if m["from"] in agents else tr("Open")
            return tr(
                "{p0} {p1} — {first}  · {where}",
                p0=label_of(cfg, m["from"]),
                p1=local_hm(m["at"]),
                first=first,
                where=where,
            ), f"{kind}:{m['id']}"

        items = [row(m, "msg") for m in unread]
        earlier = [
            row(m, "old")
            for m in reversed([m for m in for_person(everything, ctx.args.as_, all_time=True) if m["id"] in read][-20:])
        ]
        waiting = [(label + tr("  · Open agent terminal"), value) for label, value in waiting]
        if not waiting and not items and not earlier:
            say_(tr("No messages for you yet."))
            return
        others = sum(
            1 for m in everything if m["from"] != ctx.args.as_ and "all" in m["to"] and m["id"] not in read and m not in unread
        )
        mark = [(tr("✓ Mark all as read"), "all:")] if items else []
        # The line between new and earlier only when there is something new above it: with nothing new
        # the choice started on it, and it looked chosen — the question says it then.
        line_ = [(tr("── Earlier for you ──"), "sep:")] if earlier and (items or waiting) else []
        new = len(waiting) + len(items)
        prompt = (
            tr("For you · {new} new", new=new) if new else tr("No unread messages. Earlier messages are below.")
        ) + (tr(" · +{others} for everyone", others=others) if others else "")
        ctx.wizard.update(step="mine_pick", from_cmd="/mine", options=waiting + items + mark + line_ + earlier, prompt=prompt)
        return
    if line == "/restart":
        ctx.wizard.clear()
        cfg = load_config()
        mine = [
            q["id"] for q in cfg["participants"] if q.get("started_by_room") and agent_kind(q) in ("claude", "codex")
        ]
        if not mine:
            say_(tr("No agent the room started. Add one with /add."))
            return
        ctx.wizard.update(
            step="restart_pick",
            from_cmd="/restart",
            prompt=tr("Restart whom? The conversation continues"),
            options=[(label_of(cfg, x), x) for x in mine],
        )
        return
    if line.startswith("/answer "):
        # «/answer Bob», from the command menu's names or typed.
        pid = ctx.names.get(line[len("/answer ") :].strip().lower().lstrip("@"))
        if not pid or pid in ("all", ctx.args.as_):
            say_(tr("Choose someone from the list."))
            return
        ctx.wizard.clear()
        ctx.wizard.update(step="answer_pick", from_cmd="/answer")
        ctx.run_wizard_step(pid)
        return
    if line in ("/view", "/open", "/answer"):
        ctx.wizard.clear()
        cfg = load_config()
        panes = current_panes(cfg)
        others = [p["id"] for p in cfg["participants"] if p["id"] != ctx.args.as_]
        if not others:
            say_(tr("No agents in the room yet. Add one with /add."))
            return
        prompt = {
            "/view": tr("View an agent"),
            "/open": tr("Open an agent's window"),
            "/answer": tr("Answer whom?"),
        }[line]
