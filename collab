def cmd_ack(args: argparse.Namespace) -> None:
    """Mark messages read (--id or --all); --no-reply also closes them as needing no answer."""
    rp = room().paths
    config = load_config()
    participant(config, args.participant)
    if args.all == bool(args.ids):
        fail(tr("choose either --id <message-id> or --all"))
    if args.no_reply and args.all:
        fail(tr("--no-reply closes named messages only: use --id"))
    mine = {m["id"] for m in read_messages() if is_for(m, args.participant)}
    ids = mine if args.all else set(args.ids)
    missing = ids - mine
    if missing:
        fail(
            tr("not addressed to {participant}: {p1}", participant=args.participant, p1=", ".join(sorted(missing)))
        )
    write_set(rp.receipts_dir, args.participant, read_set(rp.receipts_dir, args.participant) | ids)
    if args.no_reply:
        # «Read» alone does not end the wait for an answer — otherwise «read it, answered only in
        # my own window» goes unnoticed again. This mark does: no answer is due.
        write_set(rp.noreply_dir, args.participant, read_set(rp.noreply_dir, args.participant) | ids)
        print(tr("Closed {p0} message(s) for {participant} without a reply.", p0=len(ids), participant=args.participant))
        return
    print(tr("Acknowledged {p0} message(s) for {participant}.", p0=len(ids), participant=args.participant))


