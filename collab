            pid=pid,
            options=[(tr("No"), "n"), (tr("Yes, disconnect"), "y")],
            prompt=tr("Disconnect {p0}?", p0=label_of(ctx.config, pid)),
        )
        say_(
            tr(
                "Disconnect {p0}? Room messages will stop. The agent will keep running.", p0=label_of(ctx.config, pid)
            )
        )
        return
    if step_ == "rm_confirm":
        if line.lower() not in ("y", "yes", "д", "да"):
            ctx.wizard.clear()
            say_(tr("Canceled."))
            return
        try:
            label = remove_participant(ctx.wizard["pid"])
        except ValueError as exc:
            say_(tr("! {exc}", exc=exc))
        else:
            say_(tr("{label} disconnected from the room.", label=label))
        ctx.wizard.clear()
        ctx.refresh_people()
        return
    if step_ == "kind":
        if not line.isdigit() or not 1 <= int(line) <= len(ctx.wizard["kinds"]):
            say_(tr("Enter a number from the list."))
            return
        folders = []
        for f in [str(rp.root), *room_folders(ctx.config), *recent_folders()]:
            if f not in folders:
                folders.append(f)
        folders = folders[:10]
        ctx.wizard.update(
            step="folder_pick",
            kind=ctx.wizard["kinds"][int(line) - 1],
            folders=folders,
            options=[(tilde(f), str(i)) for i, f in enumerate(folders, 1)]
            + [(tr("Browse folders…"), "browse"), (tr("Enter path manually…"), "other")],
            prompt=tr("Project folder"),
        )
        say_(tr("Project folder."))
        return
    if step_ == "browse":
        cur = Path(ctx.wizard["cwd"])
        if line == "use":
            line, step_ = str(cur), "folder"
        elif line == "up":
            ctx.show_folders(cur.parent)
            return
        elif line.startswith("in:"):
            ctx.show_folders(cur / line[3:])
            return
        elif line.startswith("denied:"):
            # In the menu's own header: a line in the feed would be under the open menu, unseen.
            # The choice stays on that row (it jumped to the top of a long list).
            # The folder's name, cleaned: the rows were, the header was not.
            ctx.wizard["prompt"] = tr("Cannot open {p0}/ — choose another folder", p0=clean_field(line[7:], 60))
            ctx.ui.menu_index = next((i for i, (_, v) in enumerate(ctx.wizard["options"]) if v == line), 0)
            return
        elif line == "type":
            ctx.wizard.update(step="folder", options=None, prompt=tr("Type the folder path (Esc to go back):"))
            say_(ctx.wizard["prompt"])
            return
        else:
            return
    if step_ == "folder_pick" and line == "browse":
        # Next to the room's own project: where the person's other projects usually are.
        ctx.show_folders(rp.root.parent if rp.root.parent != rp.root else rp.root)
        return
    if step_ == "folder_pick":
        if line == "other":
            ctx.wizard.update(step="folder", options=None, prompt=tr("Type the folder path (Esc to go back):"))
            say_(ctx.wizard["prompt"])
            return
        if not line.isdigit() or not 1 <= int(line) <= len(ctx.wizard["folders"]):
            say_(tr("Choose a folder from the list."))
            return
        line = ctx.wizard["folders"][int(line) - 1]
        step_ = "folder"
    if step_ == "folder":
        if not line:
            # An empty path never means some other project (Enter after an error
            # started the agent in the room's folder).
            say_(tr("Enter a folder path, or press Esc to choose from the list."))
            return
        try:
            folder = Path(line).expanduser()
        except RuntimeError:  # «~someone» with no such user: it dropped the whole /add
            say_(tr("Folder not found: {p0}", p0=clean_field(line, 60)))
            return
        problem = folder_problem(folder)
        if problem:
            say_(problem)
            return
        ctx.wizard.update(
            step="name_new",
            folder=str(folder.resolve()),
            options=None,
            prompt=tr("Name this agent — Enter takes the suggestion, or type another (Esc to go back):"),
        )
        say_(ctx.wizard["prompt"])
        base = PRESETS[ctx.wizard["kind"]]["label"]
        suggestion = next(
            n
            for n in [base] + [tr("{base} {i}", base=base, i=i) for i in range(2, 100)]
            if not label_taken(ctx.config, "", n)
        )
        ctx.buffer()[:] = list(suggestion)
        ctx.ui.pos = len(ctx.buffer())
        ctx.ui.suggested = True  # like selected text: the first letter typed replaces it
        return
    if step_ == "name_new":
        label = line
        if not label:
            say_(tr("Enter a name."))
            return
        # The same checks as /name: /add gave two agents one name.
        problem = name_problem(label) or (
            tr("that is already someone else's name here") if label_taken(ctx.config, "", label) else ""
        )
        if problem:
            say_(tr("! {problem}. Try another name.", problem=problem))
            return
        try:
            pid = launch_new_agent(ctx.config, ctx.wizard["kind"], ctx.wizard["folder"], label)
        except SystemExit as exc:
            # fail() must not close the owner's seat: say it, with the reason, and stay.
            ctx.wizard.clear()
            ctx.feed(paint(tr("! Could not start the agent: {exc}. Try /add again.", exc=exc), "1;38;5;196"))
            return
        say_(tr("Starting {label} in room window {pid}. Waiting for a connection check reply.", label=label, pid=pid))
        say_(tr("Settings: {p0}.", p0=settings_words(ctx.wizard["kind"], {"id": pid}, load_config())))
        ctx.wizard.clear()
        ctx.refresh_people()
        return

