SCREEN_STALE_MIN = 2.0


def describe(pid: str, st: dict[str, Any], stale_min: float, lang: str = "en") -> str:
    # Cleaned on show too: status.json may be written by others, and `collab status` printed its
    # escape codes straight to the terminal.
    state, detail = st.get("state", "unknown"), clean_field(str(st.get("detail", "")), 300)
    state = state if isinstance(state, str) and state in STATES else "unknown"  # a list is unhashable
    # What the deliverer read from the screen is renewed every second while it runs: two minutes old,
    # it has stopped, and the last states must not pass for live ones.
    limit = stale_min if st.get("source") == "self" else SCREEN_STALE_MIN if st.get("source") == "screen" else None
    if limit is not None:
        try:
            age = (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(st["at"])).total_seconds() / 60
        except (KeyError, ValueError):
            age = 0
        if age > limit:
            last = status_word(BAR_WORDS.get(state, state), lang)
            if st.get("source") == "self":
                return tr("· {pid}: No update for {n} min (last seen: {last})", lang, pid=pid, n=int(age), last=last)
            return tr(
                "· {pid}: No update for {n} min, delivery is not running (last seen: {last})",
                lang,
                pid=pid,
                n=int(age),
                last=last,
            )
    mark = "‼" if state in ("needs_owner", "lost", "draft") else "·"
    bg = re.fullmatch(r"background (\d+)", detail) if state == "idle" else None
    if bg:
        n = int(bg.group(1))
        if n == 1:
            return tr("· {pid} is ready · 1 background task", lang, pid=pid)
        return tr("· {pid} is ready · {n} background tasks", lang, pid=pid, n=n)
    if state == "needs_owner" and not detail:
        return tr("{mark} {pid} needs your input. Open the agent's window to continue.", lang, mark=mark, pid=pid)
    words = state_words(state, STATE_WORDS.get(state, state), lang)
    if detail:
        return tr("{mark} {pid} {words}: {detail}", lang, mark=mark, pid=pid, words=words, detail=detail)
    return tr("{mark} {pid} {words}", lang, mark=mark, pid=pid, words=words)


def args_tail() -> int:
    return int(os.environ.get("COLLAB_IDLE_LINES", "10"))


def limit_of(limits: dict[str, Any], pid: str) -> dict[str, Any]:
    """The agent's limit record, its fields of the right kind only («until» a word, a record a list —
    a TypeError on every tick); anything else reads as no record."""
    rec = limits.get(pid)
    if not isinstance(rec, dict):
        return {}
    number: Callable[[object], bool] = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    return {
        k: v
        for k, v in cast("dict[str, Any]", rec).items()
        if (k in ("until", "over", "at") and number(v)) or (k == "line" and isinstance(v, str))
    }


# An agent out of its usage limit answers every message with the same notice and falls idle — the
# room took that for silence and warned the person once per message («Codex ran out
# of limits, three warnings at once»). Now: one notice, messages wait, and go out again after.
# The agent's own notice starts its line («■ You've hit your usage limit…», «5-hour limit reached ∙
# resets 3pm»); the same words inside an agent's sentence are a quote (an agent quoted Codex's
# notice in its answer, and the room put it «out of limit»).
# Before it, only the marks the agents put there themselves — Codex «■», Claude Code «⎿», «⚠»: «- »,
# «• », «* » start an item of an agent's list quoting a notice.
LIMIT_RE = re.compile(
    r"(?i)^[\s■⎿⚠]{0,6}(?:you[’']?ve |you have |claude(?: ai)? )?"
    # Claude's other limits too: «Weekly limit reached ∙ resets …», «Session limit reached», «You've
    # reached your usage limit» were missed and messages went into a stopped agent.
    r"(hit your usage limit|reached your usage limit|usage limit reached"
    r"|(?:\d+-hour|weekly|daily|session|monthly|opus|sonnet) limit reached|limit reached\b.*\bresets?\b).*"
)


# Whose notice is whose: Codex says «hit your usage limit», Claude Code «… limit reached». A Claude
# showing Codex's screen (a grep in its tool output: «⎿  ■ You’ve hit…») starts its line the same
# way, and only the agent's kind tells them apart.
LIMIT_OF_KIND = {
    "codex": re.compile(r"(?i)hit your usage limit"),
    "claude": re.compile(r"(?i)limit reached|reached your usage limit"),
}


def agent_kind(p: dict[str, Any]) -> str:
    """claude, codex — or "" for an agent of another kind, or added by hand with its own rules."""
    return p.get("kind") or ("claude" if "❯" in p.get("idle", "") else "codex" if "Ask Codex" in p.get("idle", "") else "")


def usage_limit(pane: str, kind: str = "", shot: Shot | None = None) -> str:
    """The agent's own «out of limit» line, if it is among the bottom lines of its screen; with its
    kind known, only that kind's notice counts."""
    # Every notice LIMIT_RE takes says «limit»; on the tick's look, a wrapped one is cut by a line end.
    if shot and shot.returncode == 0 and "limit" not in shot.plain.replace("\n", "").lower():
        return ""
    # -J joins wrapped lines: a narrow window cut «… try again at 6:26 PM» off its time.
    shown = tmux("capture-pane", "-p", "-J", "-t", pane, check=False).stdout or ""
    lines = [x.strip() for x in shown.splitlines() if x.strip()][-12:]
    hits = [
        m.group(0)
        for x in lines
        for m in [LIMIT_RE.search(x)]
        if m and (kind not in LIMIT_OF_KIND or LIMIT_OF_KIND[kind].search(m.group(1)))
    ]
    return hits[-1] if hits else ""


def limit_is_last(pane: str, line: str, idle: str) -> bool:
    """Is the notice the last thing the agent said — nothing but rules between it and its input? An
    old one stays on screen above what came after it: the next message and the answer to it."""
    shown = tmux("capture-pane", "-p", "-J", "-t", pane, check=False).stdout or ""
    lines = [x.strip() for x in shown.splitlines() if x.strip()]
    at = max((i for i, x in enumerate(lines) if line in x), default=-1)
    prompt = next((i for i in range(len(lines) - 1, at, -1) if idle and re.search(idle, lines[i])), len(lines))
    return at >= 0 and all(set(x) <= set("─━-") for x in lines[at + 1 : prompt])


# Codex names the day when the limit ends after midnight: «try again at Oct 2nd, 2026 12:42 AM» —
# read as «no time» it gave 15 minutes, and the room said 23:05 for 00:42.
LIMIT_DAY = r"(?:([A-Za-z]{3})[a-z]*\.? (\d{1,2})(?:st|nd|rd|th)?,? (?:(\d{4}),? )?(?:at )?)?"
# «resets in 2h 14m»: a time from now (it was read as «no time»).
LIMIT_IN = re.compile(r"(?i)(?:try again|resets?) in\s+(?:(\d+)\s*h(?:ours?|rs?)?)?\s*(?:(\d+)\s*m(?:in(?:utes?|s)?)?)?")
MONTHS: Sequence[str] = "jan feb mar apr may jun jul aug sep oct nov dec".split()


def limit_until(line: str, now_: float) -> float | None:
    """When the limit ends, from «try again at 1:26 PM» / «resets 3pm»; else in 15 minutes. None for
    a time that has just passed: an old notice still on screen — a resumed Codex shows its history,
    and «6:26 PM» seen at 19:43 was moved to tomorrow."""
    after = LIMIT_IN.search(line)
    if after and (after.group(1) or after.group(2)):
        return now_ + int(after.group(1) or 0) * 3600 + int(after.group(2) or 0) * 60 + 30
    m = re.search(r"(?i)(?:try again at|resets?(?: at)?)\s+" + LIMIT_DAY + r"(\d{1,2})(?::(\d{2}))?\s*([ap]\.?m\.?)?", line)
    if not m:
        return now_ + 900
    month, day, year = m.group(1), m.group(2), m.group(3)
    hour, minute = int(m.group(4)), int(m.group(5) or 0)
    if m.group(6):
        hour = hour % 12 + (12 if m.group(6).lower().startswith("p") else 0)
    if hour > 23 or minute > 59 or (month and month.lower() not in MONTHS):
        return now_ + 900
    at = dt.datetime.fromtimestamp(now_).replace(hour=hour, minute=minute, second=0, microsecond=0)
    if month:
        try:
            at = at.replace(year=int(year or at.year), month=MONTHS.index(month.lower()) + 1, day=int(day))
            if not year and at.timestamp() < now_ - 86400:
                at = at.replace(year=at.year + 1)  # «Jan 1st» seen on Dec 31 is next year
        except ValueError:
            return now_ + 900
        if at.timestamp() - now_ > 7 * 86400:
            # Real limits end within a week; a far date is a quoted line, and it held the agent
            # for years.
            return now_ + 900
        return at.timestamp() + 30 if at.timestamp() > now_ else None
    # A time without a date: the last time it was that o'clock, or the next. Passed within six hours,
    # it is an old notice; «11:10 PM» seen at 00:10 passed an hour ago — it was read as tonight,
    # 23 hours ahead. Limits without a date end within hours; «9am» seen at 20:00
    # is tomorrow morning.
    past = at if at.timestamp() <= now_ else at - dt.timedelta(days=1)
    if now_ - past.timestamp() < 6 * 3600:
        return None
    return (past + dt.timedelta(days=1)).timestamp() + 30


def caller_claude_session() -> str:
    """The Claude Code session this command runs under, if any: walk up the parent processes
    and take the first one that Claude registered in ~/.claude/sessions/<pid>.json."""
    sessions = Path(os.environ.get("COLLAB_CLAUDE_HOME", "~/.claude")).expanduser() / "sessions"
    pid = os.getppid()
    for _ in range(20):
        if pid <= 1:
            break
        try:
            return json.loads((sessions / f"{pid}.json").read_text(encoding="utf-8"))["sessionId"]
        except (OSError, ValueError, KeyError, TypeError):
            pass
        try:
            r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], text=True, capture_output=True, timeout=2)
            pid = int(r.stdout.strip())
        except (OSError, ValueError, subprocess.SubprocessError):
            # A sandbox may forbid `ps` (Codex's did, and `say` itself failed):
            # binding is a convenience and must never stop a message.
            break
    return ""


def caller_session_or_refuse() -> str:
    """For the seat rules (one name, one Claude; an agent renames only itself). A sandbox without
    ps is handled inside and means «not a Claude»; anything else is a fault, and a broad
    `except` turned it into «allowed» — the rules silently off. Now it refuses."""
    try:
        return caller_claude_session()
    except Exception as exc:  # noqa: BLE001 — whatever it is, the answer is «not sure», so no
        fail(tr("could not tell which Claude session runs this command ({exc}); nothing was changed", exc=exc))
        return ""


def claude_session_alive(session_id: str) -> bool:
    """Is a Claude Code session with this id still running (its process alive)?"""
    sessions = Path(os.environ.get("COLLAB_CLAUDE_HOME", "~/.claude")).expanduser() / "sessions"
    for f in sessions.glob("*.json"):
        try:
            info = json.loads(f.read_text(encoding="utf-8"))
            if info.get("sessionId") == session_id:
                os.kill(int(info.get("pid") or f.stem), 0)
                return True
        except (OSError, ValueError, TypeError):
            continue
    return False


def check_name_is_mine(pid: str, config: dict[str, Any]) -> None:
    """One name, one Claude. A second Claude, started in the same folder, wrote under the first one's name, and the
    room took it for the first one («you started duplicating each other»). A name
    held by another running session is refused, with how to join under one's own."""
    bound = next((p.get("claude_session") for p in config["participants"] if p["id"] == pid), None)
    if not bound:
        return
    sid = caller_session_or_refuse()
    if sid and sid != bound and claude_session_alive(bound):
        fail(
            tr(
                "«{p0}» ({pid}) is another running Claude session in this room. Speak under your own ID; a new agent is added by the person with /add.",
                p0=label_of(config, pid),
                pid=pid,
            )
        )


@room_locked
def bind_claude_session(pid: str) -> None:
    """The session number is automatic: when a Claude acts as a participant
    itself (joins or speaks), its session becomes the participant's — so only that session's
    hooks report the participant's state. A restarted Claude rebinds the same way."""
    sid = caller_claude_session()
    if not sid:
        return
    data = read_config_raw()
    entry = next((p for p in data["participants"] if p["id"] == pid), None)
    # A Claude speaking under a Codex's id is not that Codex: bound, it would pass for the Codex lead's own session.
    if entry is None or entry.get("claude_session") == sid or agent_kind(entry) == "codex":
        return
    entry["claude_session"] = sid
    write_config(data)


def pretty_model(raw: str) -> str:
    """«claude-opus-5-5» → «Opus 5.5»; anything unfamiliar is shown as it came."""
    m = re.fullmatch(r"claude-([a-z]+)-(\d+)(?:-(\d+))?(?:-\d{8})?(?:\[.*\])?", raw.strip())
    if not m:
        return raw.strip()
    return f"{m.group(1).capitalize()} {m.group(2)}" + (f".{m.group(3)}" if m.group(3) else "")

import hashlib
import re
import subprocess
from typing import Any

# An agent's program asking the person a question in its window — read whole, to be answered from Telegram by a
# button: its words as the program shows them, every option, the one selected. Only programs and versions whose
# dialogs were read live and whose keys were tried; anything else — no buttons, the person answers on the computer.
#
# Claude Code 2.1 (2.1.310 tried): the dialog sits under the last rule «────» exactly as wide as the window, its title
# on the next line; its last line is «Esc to cancel · Tab to amend»; options «❯ 1. Yes» / «  2. …», a long one wrapped
# by Claude itself onto lines indented under it. Every line of it but the program's «╌╌╌» is indented: the agent's
# command and words are, so a line at the first column inside it is not the program's. A digit selects AND confirms.
# Codex 0.163: the dialog begins at «Would you like to …?» and ends with «Press enter to confirm or esc to cancel»;
# options «› 1. Yes, proceed (y)». A digit selects and confirms at once.
CLAUDE_VERSION = re.compile(r"2\.1\.\d+")
CODEX_VERSION = re.compile(r"0\.163\.\d+")
CLAUDE_END = re.compile(r"^\s*Esc to cancel · Tab to amend\s*$")
CODEX_END = re.compile(r"^\s*Press enter to confirm or esc to cancel\s*$")
CODEX_TITLE = re.compile(r"^  Would you like to [^\n?]+\?$")
RULE = re.compile(r"^─{20,}$")
CLAUDE_TITLE = re.compile(r"^ \S.*$")
DOTS = re.compile(r"^╌{20,}$")
OPTION = {
    "claude": re.compile(r"^ (❯| ) (\d)\. (\S.*)$"),
    "codex": re.compile(r"^(›| ) (\d)\. (\S.*)$"),
}
MAX_LINES = 60  # a dialog longer than this is not read as one: the person answers on the computer


def program_version(kind: str, program: str, pane_pid: str) -> str:
    """The version of the program running in an agent's window — not of the one installed now: Claude Code names its
    process by its version; a Codex runs its own release's helper, the version in its path. "" — not known."""
    if kind == "claude":
        return program if CLAUDE_VERSION.fullmatch(program) else ""
    if kind != "codex" or not pane_pid.isdigit():
        return ""
    kids = subprocess.run(["pgrep", "-P", pane_pid], capture_output=True, text=True).stdout.split()[:20]
    # Under a shell too (a window the person named): the Codex is its child, its release's helper one deeper.
    kids += [g for k in kids for g in subprocess.run(["pgrep", "-P", k], capture_output=True, text=True).stdout.split()[:20]]
    for pid in kids[:60]:
        args = subprocess.run(["ps", "-ww", "-o", "args=", "-p", pid], capture_output=True, text=True).stdout
        m = re.search(r"/releases/(\d+\.\d+\.\d+)-", args)
        if m:
            return m.group(1)
    return ""


def read_prompt(kind: str, version: str, screen: str, width: int) -> dict[str, Any] | None:
    """The question an agent's program asks now, from its window's plain text (wrapped lines joined) and its width:
    {"lines": its words as shown,
    "options": [{"n", "lines"}], "selected": n, "print": what tells this question from any other}. None — no
    question this version's dialog has, or not all of it on the screen: no option is guessed."""
    if not (kind == "claude" and CLAUDE_VERSION.fullmatch(version)) and not (
        kind == "codex" and CODEX_VERSION.fullmatch(version)
    ):
        return None
    lines = [line.rstrip() for line in screen.rstrip("\n").split("\n")]
    while lines and not lines[-1]:
        lines.pop()
    if not lines or not (CLAUDE_END if kind == "claude" else CODEX_END).match(lines[-1]):
        return None
    if kind == "claude":
        top = max((i for i, line in enumerate(lines) if RULE.match(line)), default=-1)
        # The program's rule spans the window, its title right under it. A rule-like line the agent's words made —
        # a long line the terminal wrapped — is no top: the dialog's own lines above it would be hidden from the card.
        if top < 0 or len(lines[top]) != width or top + 1 >= len(lines) or not CLAUDE_TITLE.match(lines[top + 1]):
            return None
        inner = lambda line: not line or line.startswith(" ") or bool(DOTS.match(line))  # a line a dialog has
        if not all(inner(line) for line in lines[top + 1 : -1]):
            return None
        # Nor the rule of a dialog inside another: one more such rule above, only a dialog's lines between them.
        above = [i for i in range(max(0, top - MAX_LINES), top) if lines[i] == "─" * width]
        if above and all(inner(line) for line in lines[above[-1] + 1 : top]):
            return None
    else:
        # Its title is the program's own line: two spaces in, after an empty one. The command and its reason are the
        # agent's words inside the dialog — a «Would you like to …?» among them would move where the dialog seems to
        # begin and hide the command's start from the card: more than one, and it is not read at all.
        titles = [i for i, line in enumerate(lines) if CODEX_TITLE.match(line)]
        if len(titles) != 1 or titles[0] == 0 or lines[titles[0] - 1].strip():
            return None
        top = titles[0] - 1
    if top < 0 or len(lines) - top > MAX_LINES:
        return None
    region = lines[top + 1 : -1]
    words: list[str] = []
    options: list[dict[str, Any]] = []
    selected = 0
    for line in region:
        m = OPTION[kind].match(line)
        if m:
            n = int(m.group(2))
            if n != len(options) + 1:
                return None  # options out of their order: not this dialog
            options.append({"n": n, "lines": [m.group(3)]})
            if m.group(1) != " ":
                selected = n
        elif options and line.startswith("      ") and line.strip():
            options[-1]["lines"].append(line.strip())  # a long option, wrapped by the program onto its next lines
        elif options and line.strip():
            return None  # words after the options other than its last line: not a dialog read whole
        elif not options and line.strip() and not DOTS.match(line):
            words.append(line.strip())
    if len(options) < 2 or not selected or not words:
        return None
    if any("⧉" in line for line in words):
        return None  # what it asks about is open in an editor, not on the screen: not answered unseen
    shown = [*words, *(f"{o['n']}. " + "\n".join(o["lines"]) for o in options)]
    return {
        "lines": words,
        "options": options,
        "selected": selected,
        "print": hashlib.sha256("\n".join([kind, version, *shown, str(selected)]).encode()).hexdigest()[:32],
    }


def key_for(kind: str, n: int) -> str:
    """The one key that chooses option n in these programs' dialogs: its digit — it selects and confirms at once (both
    tried live; an Enter after it would go to the next screen)."""
    if kind not in ("claude", "codex") or type(n) is not int or not 1 <= n <= 9:
        raise ValueError(n)
    return "123456789"[n - 1]
"""Token spend of the room's agents, from their own session logs — numbers only.

What an agent spent since the last look: input, output, cache read and cache write, by model and effort.
Read only, never a word of the conversation: a line is parsed for its numbers and its model's name, and
nothing else of it leaves this module.
"""


import datetime as dt
import json
import os
import re
import stat
import time
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Any, cast




FIELDS = ("input", "output", "cache_read", "cache_write")
SEEN_MAX = 50_000  # answers remembered per agent; past it the oldest go, and «since» moves past them
CTX_MAX = 64  # Codex turns whose model and effort are kept for the records that follow them
CHUNK = 8 << 20  # bytes read from one log in one look; the rest waits for the next
BUDGET = 8 << 20  # and from all of an agent's logs in one call: the room's lock is held meanwhile
CONTEXT_TAIL = 2 << 20  # how far back a first look at a Codex log seeks its turn's model and effort
MARKS = {"claude": b'"usage"', "codex": b'"payload"'}
# A Codex compacted its context: its log's own record of that, at the head of a line (a quote of these words in
# a message is escaped inside a string). Its assignment is sent again (deliver.send_briefs).
COMPACTED = b'"type":"compacted"'  # a line without it has no numbers: not even parsed
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}")  # a model's or an effort's name, as shown
KEY = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}")  # an answer's id, as kept in the cursor


def cursor_path() -> Path:
    return room().paths.state_dir / "usage-cursor.json"


def clean(name: Any) -> str | None:
    """A name from a log, shown only if it looks like one: the log is the agent's to write."""
    return name if isinstance(name, str) and NAME.fullmatch(name) else None


def stamp(ts: object) -> str:
    """A log's time as the room writes its own (m_store.now: UTC, seconds, «+00:00»): Claude writes
    «…T12:34:56.789Z», Codex may write otherwise, and the report compares them as strings. One
    that cannot be read — "", and that answer is not counted."""
    try:
        return dt.datetime.fromisoformat(str(ts)).astimezone(dt.timezone.utc).isoformat(timespec="seconds")
    except (ValueError, OverflowError):  # a date at the edge of the calendar overflows on the shift
        return ""


def count(value: Any) -> int:
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else 0


def claude_home() -> Path:
    return Path(os.environ.get("COLLAB_CLAUDE_HOME", "~/.claude")).expanduser() / "projects"


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser() / "sessions"


def claude_files(p: dict[str, Any]) -> list[Path]:
    """The agent's Claude session log and its subagents' (their spend is the agent's too). The session is
    the one delivery keeps for its window (window_session): no tmux call of its own.
    After a resume the session id changes, and the new file copies the old answers: they are told apart by
    their ids and times (read_claude)."""
    sid = str(p.get("window_session") or "")
    if not SESSION_ID.fullmatch(sid):
        return []
    # /add writes the agent's folder; a seat `start` opens works in its «cwd» under the project.
    raw: object = p.get("cwd")
    cwd = raw if isinstance(raw, str) else "."  # the settings are the person's to edit
    folder = os.path.realpath(p.get("folder") or str(room().paths.root / cwd))
    base = claude_home() / re.sub(r"[^A-Za-z0-9]", "-", folder)
    subs = base / sid / "subagents"
    try:
        extra = sorted(subs / n for n in os.listdir(subs) if n.endswith(".jsonl"))
    except OSError:
        extra = []
    return [base / f"{sid}.jsonl", *extra]


def codex_file(p: dict[str, Any], known: str, code: str = "") -> tuple[list[Path], str]:
    """The agent's Codex session logs and the connection check they were found by: the one found before while the
    agent is in the same run (`code` is its join code then); after a /restart — a new check, a new conversation in a
    new file, the old one left on disk — found again, and the old one read to its end beside it. A scan of the
    sessions folder, so not on every look."""
    logs = codex_home()
    # The cursor is a file in the room's state, anyone's to edit: its path counts only inside Codex's own
    # sessions folder — nothing outside ~/.claude and ~/.codex is opened.
    had = bool(known) and os.path.isfile(known) and Path(os.path.realpath(known)).is_relative_to(os.path.realpath(logs))
    run = str(p.get("join_code") or "")
    if had and code == run:
        return [Path(known)], run
    sid = agent_session(p)
    try:
        found = sorted(logs.rglob(f"rollout-*{sid}.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True) if sid else []
    except OSError:
        found = []
    if not found:
        return ([Path(known)] if had else []), ""  # the new one not there yet: looked for again next time
    old = [Path(known)] if had and os.path.realpath(known) != os.path.realpath(found[0]) else []
    return [found[0], *old], run


def unread(p: dict[str, Any]) -> str:
    """Why the agent's spending is not read — its log not found; "" when it is. For the report: a table
    without an agent looked complete."""
    kind = agent_kind(p)
    if kind == "claude":
        files = claude_files(p)
        if not files:
            return (
                "the session of its window is not known: delivery reads it from Claude's own record once a minute while it runs"
            )
        if not files[0].is_file():
            return f"no log of its session {p.get('window_session')} in {tilde(str(files[0].parent))}"
        return ""
    if kind == "codex":
        known = next(iter(obj(obj(read_json(cursor_path())).get(p["id"])).get("files") or {}), "")
        if codex_file(p, str(known))[0]:
            return ""
        return f"no log of its session in {tilde(str(codex_home()))} (found by its connection check)"
    return "not a Claude or a Codex: its spending is not read"


def open_under(base: Path, path: Path) -> int | None:
    """The log opened from its home folder down, every step refusing a link, as the room's own state is
    (store.state_dir): a session log, or a folder on the way to it, made a link elsewhere is not read.
    None — not there, not under `base`, or a link."""
    try:
        parts = path.relative_to(base).parts
        fd = os.open(str(base), os.O_RDONLY | os.O_DIRECTORY)
    except (ValueError, OSError):
        return None
    try:
        for part in parts[:-1]:
            inner = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = inner
        f = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    except (OSError, IndexError):
        return None
    finally:
        os.close(fd)
    if not stat.S_ISREG(os.fstat(f).st_mode):
        os.close(f)
        return None
    return f


def read_new(
    base: Path, path: Path, at: dict[str, int], to_end: bool = False, limit: int = CHUNK
) -> tuple[list[bytes], dict[str, int]]:
    """The whole lines added to a log since `at` (its inode, offset, and whether it stopped inside a line),
    and where reading stopped; `to_end` — nothing read, the end noted (a first look). A new inode or a
    shorter file is a new log: read from its start. A line longer than one look's read (a tool's result,
    an image) is skipped to its end, never read again and again: numbers are in short lines. Only a
    whole look's read can tell such a line: with less of the call's budget left, a line is waited for."""
    f = open_under(base, path)
    if f is None:
        return [], at
    with os.fdopen(f, "rb") as fh:
        info = os.fstat(fh.fileno())
        if to_end:
            return [], {"ino": info.st_ino, "off": info.st_size, "mid": 0}
        same = at.get("ino") == info.st_ino and at.get("off", 0) <= info.st_size
        offset, mid = (at.get("off", 0), at.get("mid", 0)) if same else (0, 0)
        fh.seek(offset)
        data = fh.read(min(limit, CHUNK))
    start = 0
    if mid:
        first = data.find(b"\n")
        if first < 0:
            return [], {"ino": info.st_ino, "off": offset + len(data), "mid": 1}
        start = first + 1
    end = data.rfind(b"\n") + 1  # a line still being written waits for the next look
    if end <= start and len(data) == CHUNK:
        return [], {"ino": info.st_ino, "off": offset + len(data), "mid": 1}
    lines = data[start:end].splitlines() if end > start else []
    return lines, {"ino": info.st_ino, "off": offset + max(end, start), "mid": 0}


def last_context(base: Path, path: Path, ctx: dict[str, list[str | None]]) -> None:
    """A first look reads nothing — and the turn it fell in had its model and effort written before it:
    its records went out with no model. The log's last CONTEXT_TAIL bytes are looked at for
    turn_context lines only; no numbers are taken from them."""
    f = open_under(base, path)
    if f is None:
        return
    with os.fdopen(f, "rb") as fh:
        size = os.fstat(fh.fileno()).st_size
        fh.seek(max(0, size - CONTEXT_TAIL))
        data = fh.read(CONTEXT_TAIL)
    for raw in data.splitlines()[1:] if size > CONTEXT_TAIL else data.splitlines():  # the first may be cut
        if b'"turn_context"' in raw:
            read_codex(raw.decode("utf-8", errors="replace"), ctx)


def obj(x: object) -> dict[str, Any]:
    """A JSON object as a dict; anything else as an empty one — a log line is the agent's to write."""
    return cast("dict[str, Any]", x) if isinstance(x, dict) else {}


def parse(line: str) -> dict[str, Any]:
    try:
        return obj(json.loads(line))
    except ValueError:
        return {}


def claude_usage(u: dict[str, Any]) -> dict[str, int]:
    """One answer's numbers. «iterations» when it has any — the top fields are sometimes zeros while the
    numbers are there (token-sources.md, trap 3)."""
    raw: object = u.get("iterations")
    items = cast("list[object]", raw) if isinstance(raw, list) else []
    steps = [obj(x) for x in items] or [u]
    out: dict[str, int] = dict.fromkeys(FIELDS, 0)
    for step in steps:
        out["input"] += count(step.get("input_tokens"))
        out["output"] += count(step.get("output_tokens"))
        out["cache_read"] += count(step.get("cache_read_input_tokens"))
        out["cache_write"] += count(step.get("cache_creation_input_tokens"))
    return out


Answer = tuple[str, str, dict[str, int], "str | None", "str | None"]  # id, time, numbers, model, effort


def read_claude(line: str) -> Answer | None:
    """An answer line's numbers; None for any other line."""
    r = parse(line)
    msg = obj(r.get("message")) if r.get("type") == "assistant" else {}
    mid: object = msg.get("id")
    if not isinstance(mid, str) or not isinstance(msg.get("usage"), dict):
        return None
    return mid, stamp(r.get("timestamp")), claude_usage(obj(msg.get("usage"))), clean(msg.get("model")), None


def read_codex(line: str, ctx: dict[str, list[str | None]]) -> Answer | None:
    """A token_usage_record's numbers; a turn_context line only updates `ctx` (turn id -> model, effort).
    Codex counts cached input inside its input, and reasoning inside its output (token-sources.md): input
    here is what was not read from the cache."""
    r = parse(line)
    pay = obj(r.get("payload"))
    turn = pay.get("turn_id")
    if r.get("type") == "turn_context" and isinstance(turn, str):
        ctx[turn] = [clean(pay.get("model")), clean(pay.get("effort"))]
        while len(ctx) > CTX_MAX:
            ctx.pop(next(iter(ctx)))
        return None
    if r.get("type") != "token_usage_record" or not isinstance(pay.get("usage"), dict):
        return None
    u = obj(pay.get("usage"))
    cached = count(u.get("cached_input_tokens"))
    nums = {
        "input": max(0, count(u.get("input_tokens")) - cached),
        "output": count(u.get("output_tokens")),
        "cache_read": cached,
        "cache_write": count(u.get("cache_write_input_tokens")),
    }
    model, effort = ctx.get(str(turn), [None, None])
    thread, resp = pay.get("thread_id"), pay.get("response_id")
    # Both parts or no key: «None:None» would make every record without them one answer.
    key = f"{thread}:{resp}" if isinstance(thread, str) and isinstance(resp, str) else ""
    return key, stamp(r.get("timestamp")), nums, model, effort


@dataclass
class Cursor:
    """Where one agent's counting stands: since when, how far into each log, the answers already counted
    (id -> time), a Codex log's recent turns (turn id -> model, effort) and the run its log is of."""

    since: str
    files: dict[str, dict[str, int]] = field(default_factory=lambda: {})
    seen: dict[str, str] = field(default_factory=lambda: {})
    ctx: dict[str, list[str | None]] = field(default_factory=lambda: {})
    code: str = ""  # a Codex's: the join code of the run its log was found for

    @classmethod
    def load(cls, raw: object) -> Cursor | None:
        """The stored cursor, its parts that are not of their shape dropped; None — none stored."""
        r = obj(raw)
        if not isinstance(r.get("since"), str):
            return None
        files = {k: {f: count(obj(v).get(f)) for f in ("ino", "off", "mid")} for k, v in obj(r.get("files")).items()}
        seen = {k: v for k, v in obj(r.get("seen")).items() if isinstance(v, str)}
        ctx = {
            k: [clean(x) for x in cast("list[object]", v)][:2]
            for k, v in obj(r.get("ctx")).items()
            if isinstance(v, list) and len(cast("list[object]", v)) == 2
        }
        return cls(r["since"], files, seen, ctx, r["code"] if isinstance(r.get("code"), str) else "")


def increment(p: dict[str, Any]) -> list[dict[str, Any]]:
    """What the agent spent since the last call: one record per model and effort — {model, effort, input,
    output, cache_read, cache_write, answers, ctx_max, ctx_last, from_ts, to_ts}: the answers counted, the
    longest context of one (input + cache read + cache write) and that of the latest, times of the first
    and last answer. Nothing
    new — []. The first call for an agent starts from now: its past is not counted against the task it is
    on. Called under the room's lock by its one writer (delivery's tick); the cursor is in the room's state,
    so a restart of delivery neither counts again nor loses a piece."""
    kind = agent_kind(p)
    if kind not in ("claude", "codex"):
        return []
    state = read_json(cursor_path())
    stored = Cursor.load(state.get(p["id"]))
    fresh = stored is None
    cur = stored or Cursor(now())
    base = claude_home() if kind == "claude" else codex_home()
    if kind == "claude":
        files = claude_files(p)
    else:
        files, cur.code = codex_file(p, next(iter(cur.files), ""), cur.code)
    groups: dict[tuple[str | None, str | None], dict[str, Any]] = {}
    read_to: dict[str, dict[str, int]] = {}
    compacted: list[float] = []
    left = BUDGET
    for path in files:
        at = cur.files.get(str(path), {})
        if left <= 0:
            # The call's budget spent: this log waits where it was, for the next call (a day's backlog of
            # 400 MB after a long stop — say, ack and delivery waited for the room's lock all that while).
            read_to[str(path)] = at
            continue
        # A first look starts from now: what is in the log already is not this task's. A log that appears
        # later (a resumed session, a new subagent) is read from its start: its copies of old answers are
        # told by their ids and times below.
        lines, read_to[str(path)] = read_new(base, path, at, to_end=fresh, limit=left)
        if fresh and kind == "codex":
            last_context(base, path, cur.ctx)
        if fresh:
            pass  # a first look notes the end and reads nothing: no budget spent
        elif read_to[str(path)].get("ino") == at.get("ino"):
            left -= read_to[str(path)].get("off", 0) - at.get("off", 0)
        else:
            left -= read_to[str(path)].get("off", 0)
        for raw in lines:
            if kind == "codex" and COMPACTED in raw[:200]:
                compacted.append(time.time())
            if MARKS[kind] not in raw:
                continue
            line = raw.decode("utf-8", errors="replace")
            got = read_claude(line) if kind == "claude" else read_codex(line, cur.ctx)
            if not got:
                continue
            key, ts, nums, model, effort = got
            # A copy of an answer (a resumed session's new file repeats the old ones, a reply is written
            # in several lines with one id): counted once. Older than the cursor: not this cursor's.
            if not ts or not KEY.fullmatch(key) or key in cur.seen or ts < cur.since:
                continue
            cur.seen[key] = ts
            g = groups.setdefault(
                (model, effort), {"model": model, "effort": effort, **dict.fromkeys(FIELDS, 0), "answers": 0, "ctx_max": 0}
            )
            for f in FIELDS:
                g[f] += nums[f]
            g["answers"] += 1
            size = nums["input"] + nums["cache_read"] + nums["cache_write"]
            g["ctx_max"] = max(g["ctx_max"], size)
            if ts >= (g.get("to_ts") or ""):
                g["ctx_last"] = size  # the context as it is now: what the latest answer read
            g["from_ts"] = min(g.get("from_ts") or ts, ts)
            g["to_ts"] = max(g.get("to_ts") or ts, ts)
    cur.files = read_to  # a log no longer the agent's (its session ended) is not looked at again
    if len(cur.seen) > SEEN_MAX:
        keep = sorted(cur.seen.items(), key=lambda kv: kv[1])[-SEEN_MAX:]
        cur.seen, cur.since = dict(keep), keep[0][1]
    state[p["id"]] = asdict(cur)
    write_json(cursor_path(), state)
    if compacted:
        seen = read_json(compacted_path())
        write_json(compacted_path(), {**seen, p["id"]: compacted[-1]})
    return [g for g in groups.values() if any(g[f] for f in FIELDS)]

