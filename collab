    """The team before its launch, as it is now — the scenario's or as the person changed it — and what can be done
    with it: launch, change, add, remove. Nothing starts before «Launch the team»."""
    name, draft = ctx.wizard["scenario"], ctx.wizard["draft"]
    missing = scenario_unavailable({"seats": draft})
    back = (words_in("team.back", lang), "back")
    edits = [(words_in(f"team.{x}", lang), x) for x in ("edit", "add", "remove")]
    options = (
        [back] if missing else [(words_in("team.launch", lang, agents=agents_words(len(draft), lang)), "go"), *edits, back]
    )
    question = (
        words_in("team.unavailable", lang, what="; ".join(missing))
        if missing
        else words_in("team.launch.question", lang)
    )
    ctx.wizard.update(step="scenario_go", prompt=question, options=options)
