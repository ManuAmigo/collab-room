        "that is already someone else's name here" if label_taken(config, "", label) else ""
    )
    if problem:
        fail(problem)
    own = settings_args(args, config)
    if own:
        # An agent's settings are the person's to give: from a command line they are a proposal, applied with Enter
        # in the chat — whoever runs this, a person or an agent.
        add = {"kind": args.kind, "label": label, "folder": str(folder.resolve()), **own}
        propose(ROOM, "", {"add": [add]}, config)
        return
    pid = launch_new_agent(config, args.kind, str(folder.resolve()), label, own)
    # Not typed in a chat: the people learn who came in, and where it works.
    room_line(
        people_ids(load_config()),
        "{label} ({base}) was added by collab add, in {folder}.",
        label=visible(label),
        base=base,
        folder=visible(tilde(str(folder.resolve()))),
    )
    how = "its window tells its session" if args.kind == "claude" else "it answers the connection check"
    print(tr("Starting {label} in room window {pid}. It joins when {how} (collab status).", label=label, pid=pid, how=how))
    print(tr("Settings: {p0}.", p0=settings_words(args.kind, {"id": pid, **own}, load_config())))


def settings_args(args: argparse.Namespace, config: dict[str, Any]) -> dict[str, Any]:
    """The settings `collab add` was given — only these become the agent's own. Checked before anything
    starts: a bad one is refused, not skipped. The person's to give: an agent that adds another may not
    make it the lead, have the team report to it, or pick its model — it asks the person."""
    own: dict[str, Any] = {}
    if args.context_trim:
        own["context_trim"] = trim_arg(args.kind, args.context_trim)
    for key, value in (("role", args.role), ("topic", args.topic), ("use_model", args.model), ("reports_to", args.reports_to)):
        if value is None:
            continue
        problem = setting_problem(key, value, config)
        if problem:
            fail(tr("--{p0}: {problem}", p0=key.replace("use_", "").replace("_", "-"), problem=problem))
        own[key] = value
    return own


def trim_arg(kind: str, text: str) -> object:
    """`--context-trim 150000:compact`, `…:clear` or `off`: the agent's own, over the room's."""
    if text == "off":
        return False
    at, _, do = text.partition(":")
    rule = {"at": int(at), "do": do} if at.isdigit() else None
    if not trim_valid(rule):
        fail(tr("--context-trim takes TOKENS:compact, TOKENS:clear or off — say 150000:compact"))
    if kind not in TRIM_KINDS:
        fail(tr("--context-trim: a {p0} takes only off for now", p0=PRESETS[kind]["label"]))
    return rule


