        tmux("set-option", "-p", "-t", os.environ["TMUX_PANE"], "@collab_title", tmux_text(text), check=False)


@room_locked
def add_participant(entry: dict[str, Any]) -> None:
    """Add or replace a participant. It starts from now: messages from before it joined — or
    from while it was disconnected — are neither delivered nor shown as unread."""
    rp = room().paths
    old = {m["id"] for m in read_messages()}
    write_set(rp.delivered_dir, entry["id"], old)
    write_set(rp.receipts_dir, entry["id"], old)
    data = read_config_raw()
    data["participants"] = [p for p in data["participants"] if p["id"] != entry["id"]] + [entry]
    write_config(data)


# Whether a codex program's own help names --no-daemon, by its path, its file and the subcommand.
_NO_DAEMON: dict[tuple[str, ...], bool] = {}


def codex_knows_no_daemon(program: str, sub: list[str]) -> bool:
    """Does this codex (or its `resume`) take --no-daemon? Its own help says — nothing else is run.
    Not said, or no answer in 3 seconds: no, and it starts as before rather than not at all."""
    try:
        st = os.stat(program)
    except OSError:
        return False
    key = (program, *sub, str(st.st_mtime_ns), str(st.st_size))
    if key not in _NO_DAEMON:
        try:
            r = subprocess.run([program, *sub, "--help"], capture_output=True, text=True, timeout=3, stdin=subprocess.DEVNULL)
            _NO_DAEMON[key] = r.returncode == 0 and any(line.split()[:1] == ["--no-daemon"] for line in r.stdout.splitlines())
        except (OSError, subprocess.SubprocessError):
            _NO_DAEMON[key] = False
    return _NO_DAEMON[key]


def agent_command(kind: str, resume: list[str] | None = None) -> str:
    """The same preset arguments for /add, relaunch and /restart, including resume."""
    preset = PRESETS[kind]["command"]
    program = shutil.which(preset[0]) or preset[0]
    if kind == "codex":
        # Its own process, not the shared background server (the person's Codex app keeps one): through
        # it a room's Codex did not take the rule written for it just before its start, and the person
        # approved every say by hand. Sandbox and approvals stay as they are.
        flags = ["--no-daemon"] if codex_knows_no_daemon(program, (resume or [])[:1]) else []
        if resume:
            return shlex.join([program, resume[0], *preset[1:], *flags, *resume[1:]])
        return shlex.join([program, *preset[1:], *flags])
    return shlex.join([program, *preset[1:], *(resume or [])])


@room_locked
def launch_new_agent(config: dict[str, Any], kind: str, folder: str, label: str) -> str:
    """Start an agent in its own window of the room's tmux session and register it."""
    inst = paths()
    # The id and the name by the room's file as it is now, under its lock — not the chat's copy: two
    # /add at once (two chats, or /add and a join) got one id, and add_participant replaced the first
    # The session too: `start --session` writes it there, a chat started before kept the
    # old one, and the window went to a session that was not the room's.
    fresh = load_config()
    session = fresh.get("session", "collab-room")
    if label_taken(fresh, "", label):
        raise SystemExit("that is already someone else's name here")
    pid = slug(label, ids_of(fresh), kind)
    cli = codex_room_rule(pid, folder) if kind == "codex" else ""  # before it starts: Codex reads rules at start
    pane = ""
    try:
        out = tmux(
            "new-window",
            "-d",
            "-P",
            "-F",
            "#{pane_id} #{pane_pid}",
            "-t",
            f"={session}:",
            "-n",
            pid,
            "-c",
            tmux_dir(folder),
            *pane_env(),
            in_dir(folder, agent_command(kind)),
            check=False,
        )
        if out.returncode != 0:
            raise SystemExit(out.stderr.strip() or "tmux could not open a window")
        pane, _, pane_pid = out.stdout.strip().partition(" ")
        code = uuid.uuid4().hex[:4]
        entry = {
            "id": pid,
            "label": label,
            **{k: v for k, v in PRESETS[kind].items() if k not in ("label", "command")},
            "target": pane,
            "pane_pid": pane_pid,
            "delivery": "tmux",
            "joined": "pending",
            "joined_at": now(),
            "join_code": code,
            "started_by_room": True,
            "kind": kind,
            "folder": folder,
            **({"cli": cli} if cli else {}),
        }
        add_participant(entry)
    except BaseException:
        # Half-started is undone: a rule for an id no one holds, or an agent running in
        # a window the room does not know of. The window is the one just opened, by its fresh id.
        if pane:
            tmux("kill-pane", "-t", pane, check=False)
        if cli:
            for spelling in room_spellings():
                set_agent_rule(spelling, pid, "")
        raise
    write_status(pid, "joining", "", "self")
    append_message(ROOM, [pid], ping_text(code))
    if kind == "codex" and not cli and inst.codex_consent.exists():
        # The person agreed at install, yet this Codex asks before every reply — say
        # why (nothing silently). No rule is the safe answer; it stays that way.
        if codex_writable_roots() is None:
            why = f"Codex's settings {inst.codex_home / 'config.toml'} could not be read for sure"
        elif not trusted_interpreter(sys.executable):
            why = (
                f"this collab runs on {sys.executable}, which lies where an agent could change it "
                "(run collab install to use a Python installed outside your home folder)"
            )
        else:
            why = "Codex may write to files its permission would rely on (collab, its Python or the room's folder)"
        append_message(
            ROOM,
            people_ids(config),
            f"{label} will ask you before each room reply: {why}, so no permission was given.",
        )
    return pid


def room_folders(config: dict[str, Any]) -> list[str]:
    """Where the room's agents already work (their tmux panes' folders) — of a window that is still
    the agent's: a bare «%N» after a tmux restart is anyone's, and its folder was offered."""
    out = []
    for p in config.get("participants", []):
        if p.get("target") and p.get("pane", True) is not False and not pane_guard(p, p["target"], idle=False):
            r = tmux("display-message", "-p", "-t", p["target"], "#{pane_current_path}", check=False)
            path = r.stdout.strip() if r.returncode == 0 else ""
            if path and path not in out:
                out.append(path)
    return out


def folder_rows(cur: Path) -> list[tuple[str, str]]:
    """One screen of the folder browser («browse the folders right in the menu; typing
    a path is the last resort»): use this one, go up, go into a subfolder, or type a path. Values:
    "use", "up", "in:<name>", "type", "denied:<name>". A folder that can't be opened says so
    (chosen anyway, its agent died at once with no reason given)."""
    rows = [(f"✓ Use this folder — {tilde(str(cur))}", "use")]
    if cur.parent != cur:
        rows.append(("↑ Parent folder", "up"))
    try:
        subs = sorted((d.name for d in cur.iterdir() if not d.name.startswith(".") and d.is_dir()), key=str.lower)
    except OSError:
        subs = []
    shown = {name: visible(name).replace("\n", " ") for name in subs}  # as in tilde()
    rows += [
        (f"  {shown[name]}/", "in:" + name)
        if os.access(cur / name, os.R_OK | os.X_OK)
        else (f"  {shown[name]} — no access", "denied:" + name)
        for name in subs
    ]
    return rows + [("Enter path manually…", "type")]


def folder_problem(folder: Path) -> str:
    """Why an agent can't start in this folder, or "". Not only this process: the agent is started
    by the tmux server, and on macOS it may lack access this terminal has."""
    # The real path: tmux runs its check in its server's folder, not ours — a relative one was checked
    # somewhere else.
    folder = folder.resolve()
    if not folder.is_dir():
        return f"Folder not found: {tilde(str(folder))}"
    if not os.access(folder, os.R_OK | os.X_OK) or not tmux_can_read(folder):
        return f"Cannot open this folder: {tilde(str(folder))}. Choose another folder."
    return ""


