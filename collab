def cmd_watch(args: argparse.Namespace) -> None:
    """One line block per new message. `--for all` shows the whole room (for people)."""
    rp = room().paths
    config = load_config()
    everyone = args.participant == "all"
    if not everyone:
        participant(config, args.participant)
    # A participant's watch starts from what it has not acknowledged, not from "now": a watcher
    # restarted after a crash or an expired timer would otherwise silently skip what arrived
    # while it was down. The room view (`all`) has no acks, so it starts from now unless --backlog.
    if everyone:
        seen = {m["id"] for m in read_messages()} if not args.backlog else set()
    else:
        acked = read_set(rp.receipts_dir, args.participant)
        seen = {m["id"] for m in read_messages() if m["id"] in acked or not is_for(m, args.participant)}
    if not args.quiet:
        print(tr("Watching {p0}; Ctrl-C to stop.", p0="the room" if everyone else args.participant), flush=True)
    try:
        while True:
            acked = set() if everyone else read_set(rp.receipts_dir, args.participant)
            if not everyone and load_config().get("paused"):
                # Paused: an agent reading for itself hears nothing either; what arrives waits and
                # comes on resume.
                if args.once:
                    return
                time.sleep(args.interval)
                continue
            if not everyone and any(
                p["id"] == args.participant and p.get("muted") for p in load_config()["participants"]
            ):
                # Muted: room-wide talk is not for its ears (and is not re-sent after unmute);
                # a message addressed to it by name still comes through.
                seen.update(m["id"] for m in read_messages() if args.participant not in m.get("to", []))
            for m in read_messages():
                if m["id"] in seen:
                    continue
                seen.add(m["id"])
                if everyone or (is_for(m, args.participant) and m["id"] not in acked):
                    print(fmt(m, with_id=not everyone, config=config), flush=True)
            if args.once:
                return
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass


