#!/usr/bin/env python3
"""collab-room: local message room and tmux launcher for teams of people and AI agents.

The room is a local append-only log (.collab/messages.jsonl). Every participant is a
stable `id` from .collab.json; the number of participants is not fixed.

Delivery is explicit and per participant:
  - "pull": the participant reads its inbox itself (Claude Code does it with a
    background watch, a person with `collab chat`);
  - "tmux": `collab deliver` types the message into the participant's tmux pane,
    but only when the pane looks idle (the participant's `idle` regex matches the
    visible screen). It sends the text and one Enter — never Esc, Ctrl-C or any
    other key — so it cannot cancel a running turn or answer an approval prompt.
"""

from __future__ import annotations
import contextlib
import hashlib
import json
import os
import re
import stat
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable


@dataclass(frozen=True)
class InstallPaths:
    """Where collab keeps what is the person's own, not one room's: they follow HOME and the
    environment. One set, swapped whole: nothing reassigns a path one by one."""

    # Codex must not have to ask before every reply — its rule needs Codex's config read as
    # TOML (tomllib, Python 3.11+); on macOS's own python3 (3.9) it could not be, and no rule was given.
    # `collab install` finds or installs a 3.11+ and records it here; collab started by
    # an older one — a «python3» shebang, Claude's hooks, an agent's «python3 …/collab say» — runs itself
    # again with that one. Nothing in rooms or hooks has to change.
    # A fixed place, not one an environment variable could move.
    python_file: Path
    # Folders that are collab's own, by their default places only: these are closed when found open to
    # reading. Not by the environment — COLLAB_INVITES=~/x/invites must not make collab chmod the person's ~/x.
    own_dirs: tuple[Path, ...]
    codex_home: Path
    agent_rules: Path
    codex_consent: Path
    # The files every room of the person shares — the room list and the Codex rules — were changed
    # read-modify-write with no lock: two rooms at once lost an entry, and a rule one
    # room had just dropped could be written back by another.
    shared_lock: Path
    safe_copies: Path
    # Where install put the `collab` command, and the clone it was installed from. Fixed
    # places, as python_file: what runs now is what that command leads to — a running chat's own file
    # is a copy that never changes, and comparing with it, the chat never knew it was old.
    installed_file: Path
    source_file: Path
    invites: Path
    welcomed_path: Path
    owner_key: Path  # the person's signing key — see UNSIGNED
    rooms_path: Path

    @classmethod
    def now(cls) -> "InstallPaths":
        """The paths for HOME and the environment as they are now."""
        home = Path("~").expanduser()
        codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
        invites = Path(os.environ.get("COLLAB_INVITES", "~/.collab-room/invites")).expanduser()
        consent = invites.parent / "codex-room-replies"
        return cls(
            python_file=home / ".collab-room" / "python",
            own_dirs=(home / ".collab-room", home / ".collab-room" / "rooms", home / ".local" / "share" / "collab-room"),
            codex_home=codex_home,
            agent_rules=codex_home / "rules" / "collab-room-agents.rules",
            codex_consent=consent,
            shared_lock=consent.parent / "shared.lock",
            safe_copies=Path(os.environ.get("COLLAB_SAFE_DIR", "~/.local/share/collab-room")).expanduser(),
            installed_file=home / ".collab-room" / "installed",
            source_file=home / ".collab-room" / "source",
            invites=invites,
            welcomed_path=invites.parent / "welcomed",
            owner_key=invites.parent / "owner.key",
            rooms_path=Path(os.environ.get("COLLAB_ROOMS", "~/.collab-room/rooms.json")).expanduser(),
        )


class Install:
    """The person's paths for this process; changed only by one assignment of a whole set."""

    def __init__(self, install_paths: InstallPaths) -> None:
        self.paths = install_paths


_INSTALL = Install(InstallPaths.now())


def install() -> Install:
    return _INSTALL


def paths() -> InstallPaths:
    """Read once per operation: `p = paths()`, then p.… to its end."""
    return _INSTALL.paths


# Temporary folders: Codex writes there by default (workspace-write); no room, agent or Python lives there.
TEMP_FOLDERS = ("/private/", "/tmp/", "/var/folders/")


def in_temp_folder(real: str) -> bool:
    """A real path in a temporary folder — where Codex writes by default. A fixed list: no setting
    loosens a security check."""
    return (real + "/").startswith((*TEMP_FOLDERS, os.path.realpath(tempfile.gettempdir()) + "/"))


def _safe_mode(st: os.stat_result, group_may_write: bool = False) -> bool:
    """Owned by this user (or root, as python.org's and the system's are); writable by no one else.
    The one exception, for an interpreter only: root-owned with group admin (gid 80) writing, as
    python.org installs it — admin members can sudo anyway, so it gives no one new power. Any other
    group that may write: refused; for our own folder and pointer: no group at all."""
    if st.st_uid not in (os.getuid(), 0) or st.st_mode & stat.S_IWOTH:
        return False
    return not st.st_mode & stat.S_IWGRP or (group_may_write and sys.platform == "darwin" and st.st_uid == 0 and st.st_gid == 80)


def _inside(path: str, folder: str) -> bool:
    """Is `path` inside `folder` — by file identity, not by spelling: on macOS «/Users/a» and
    «/users/A» are one folder."""
    try:
        target = os.stat(folder)
    except OSError:
        return False
    for parent in Path(path).parents:
        with contextlib.suppress(OSError):
            st = os.stat(parent)
            if (st.st_dev, st.st_ino) == (target.st_dev, target.st_ino):
                return True
    return False


def _folder_kept(folder: str) -> bool:
    """A folder the person's or root's that no one else writes — group admin aside (Homebrew's folders
    are the person's with admin writing; admin members can sudo anyway)."""
    try:
        fs = os.lstat(folder)
    except OSError:
        return False
    if fs.st_uid not in (os.getuid(), 0) or fs.st_mode & stat.S_IWOTH:
        return False
    return not fs.st_mode & stat.S_IWGRP or (sys.platform == "darwin" and fs.st_gid in (0, 80))  # macOS wheel/admin


def _link_folder_kept(folder: str) -> bool:
    """A folder holding a link on the way to a Python: kept, and — like the Python itself — not in
    home or a temporary folder, where an agent working as the person writes."""
    return _folder_kept(folder) and not in_temp_folder(folder) and not _inside(folder, str(Path.home()))


def trusted_interpreter(path: str) -> bool:
    """A Python we may run as the person: its real file, not inside a virtual environment (a project's
    .venv is where an agent writes), regular, safe mode. Checked before it is ever run."""
    real = os.path.realpath(path)
    # A Python by name: the pointer lies in home, and an agent allowed to write there could point it
    # at any program outside home — /bin/sh, osascript — run with the person's arguments.
    # A second line, not the border: a Codex that may write home already owns ~/.zshrc, ~/.claude and
    # the rest. The border is not letting Codex write home — and then no room rule is given.
    if not re.fullmatch(r"python3(\.\d+)?", os.path.basename(real)):
        return False
    # Only one installed outside the home folder — the system's, python.org's, Homebrew's. What lies
    # in home (uv's, pyenv's, a project's .venv) an agent allowed to write there could change, and the
    # person's next collab would run it.
    if _inside(real, str(Path.home())):
        return False
    if any(os.path.exists(os.path.join(p, "pyvenv.cfg")) for p in Path(real).parents):
        return False
    # Nor in a temporary folder: Codex writes /tmp and $TMPDIR by default, and no real Python lives there.
    if in_temp_folder(real):
        return False
    try:
        st = os.lstat(real)
    except OSError:
        return False
    # Every folder above it, and every folder holding a link on the way to it: kept.
    if not all(_folder_kept(str(folder)) for folder in Path(real).parents):
        return False
    if not all(_link_folder_kept(folder) for folder in link_folders(path)):
        return False
    return stat.S_ISREG(st.st_mode) and _safe_mode(st, group_may_write=True) and os.access(real, os.X_OK)


def link_folders(path: str) -> list[str]:
    """Every folder that holds a link on the way from `path` to its real file — whoever may write one of
    them may point the path elsewhere (a recorded link, /opt/homebrew/opt/…)."""
    out: list[str] = []
    head, rest, hops = "/", os.path.abspath(path).strip("/").split("/"), 0
    while rest and hops < 40:
        nxt = os.path.join(head, rest.pop(0))
        if os.path.islink(nxt):
            hops += 1
            out.append(head)
            # head holds no links (built from «/» of plain folders): «..» in the target is plain text here.
            rest = os.path.normpath(os.path.join(head, os.readlink(nxt))).strip("/").split("/") + rest
            head = "/"
        else:
            head = nxt
    return out


def read_private(path: Path) -> str:
    """A small file of ours in ~/.collab-room, or "" — read through one descriptor that refuses links,
    from a folder and a file nobody else can write (the installed and source files too)."""
    try:
        folder = os.lstat(path.parent)
        if not stat.S_ISDIR(folder.st_mode) or not _safe_mode(folder):
            return ""
        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return ""
    with os.fdopen(fd, encoding="utf-8") as f:
        st = os.fstat(f.fileno())
        # More than one name — a second name someone made — is refused. None (0) is the old file
        # install has just replaced while we read it: still what we wrote.
        if not stat.S_ISREG(st.st_mode) or st.st_nlink > 1 or not _safe_mode(st):
            return ""
        try:
            return f.read(4096).strip()
        except (OSError, UnicodeDecodeError):
            return ""


def recorded_python(as_written: bool = False) -> str:
    """The real path of the Python `collab install` recorded (as_written: the path as recorded, which
    may be a link), or "" (read_private)."""
    inst = paths()
    path = read_private(inst.python_file)
    if not os.path.isabs(path):
        return ""
    # Resolved once: what is checked is what is returned and run. The links on
    # the way are checked by their folders (trusted_interpreter, agent_folders below).
    real = os.path.realpath(path)
    if not trusted_interpreter(real) or not all(_link_folder_kept(folder) for folder in link_folders(path)):
        return ""
    # Not inside a room's project or an agent's folder — an agent added after install could work
    # where the recorded Python lies, and every collab on an older python3 runs it.
    # The recorded path may be a link that outlives an upgrade: every folder holding a link counts too.
    if any(_inside(where, folder) for where in [real, *link_folders(path)] for folder in agent_folders()):
        return ""
    return path if as_written else real


def _start_dir() -> Path:
    """The room's folder: COLLAB_ROOT, else where we are. os.getcwd() is not asked when the room is
    named — inside a tmux server started from a restricted program it fails even for a folder that
    exists, and every room pane crashed at start."""
    if os.environ.get("COLLAB_ROOT"):
        return Path(os.environ["COLLAB_ROOT"])
    try:
        return Path.cwd()
    except OSError:
        return Path(os.environ.get("PWD") or ".")


def room_home(root: Path) -> Path:
    """Where a room keeps its files: ~/.collab-room/rooms/<folder>-<hash of its real path>, outside
    the project. In the project a sandboxed Codex working there could change .collab.json — the
    commands that `collab start`, run by the person, executes. The
    room is still named by its project folder; the real path (no links, /tmp = /private/tmp)
    keeps one folder one room."""
    base = os.environ.get("COLLAB_STATE_HOME") or str(
        Path(os.environ.get("COLLAB_INVITES", "~/.collab-room/invites")).expanduser().parent / "rooms"
    )
    real = os.path.realpath(str(Path(root).expanduser()))
    name = re.sub(r"[^A-Za-z0-9_.-]+", "-", Path(real).name.lstrip(".") or "room")[:40] or "room"
    return Path(base).expanduser() / f"{name}-{hashlib.sha256(real.encode('utf-8')).hexdigest()[:12]}"


def room_session_name(root: Path) -> str:
    """The room's tmux session: its folder's name and a short hash of its real path — two projects
    named «app» shared one session, and `collab stop` in one closed the other's agents."""
    real = os.path.realpath(str(Path(root).expanduser()))
    name = re.sub(r"[^A-Za-z0-9_-]", "-", Path(real).name)[:24] or "room"
    return f"collab-{name}-{hashlib.sha256(real.encode('utf-8')).hexdigest()[:6]}"


def room_base(root: Path) -> Path:
    """The folder holding .collab.json and .collab/: the room's home; the project itself only for
    a room made by an older version and not moved yet (`collab start` moves it)."""
    home = room_home(root)
    if (home / ".collab.json").exists() or not (Path(root) / ".collab.json").is_file():
        return home
    return Path(root)


def room_config(root: Path) -> Path:
    return room_base(root) / ".collab.json"


def _plain_json(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def agent_workplaces(agent: Callable[[dict[str, Any]], bool] | None = None) -> list[tuple[str, str]]:
    """Every folder an agent may write as its own, as (whose, folder) — whose is "" for a room's project.
    One list for every check (gathered three ways, the Python checks missed a room known
    only by its home and an agent's cwd). `agent` picks whose folders count (all — None); a room's
    project counts when any of its agents does, or always with None. Plain JSON and nothing defined
    further down: it runs before the hand-over too, on an older Python."""
    sources: dict[str, tuple[str, Path]] = {}
    # Every room there is, not the menu's list: known_rooms() hides rooms in temporary
    # folders by COLLAB_TEMP_PREFIXES — a setting must not loosen a safety check. So: every room of
    # rooms.json as it is (one not moved yet keeps its .collab.json in the project itself)…
    rooms = _plain_json(Path(os.environ.get("COLLAB_ROOMS", "~/.collab-room/rooms.json")).expanduser())
    for room_dir in rooms:
        if isinstance(room_dir, str) and os.path.isabs(room_dir):
            cfg = room_config(Path(room_dir))
            sources.setdefault(os.path.realpath(cfg), (room_dir, cfg))
    # …the agents' recent folders that hold a room — an extra source (a room not moved and not in
    # rooms.json); defined further down, so not read before the hand-over…
    recent = globals().get("recent_folders")
    for folder in recent() if recent else []:
        cfg = room_config(Path(folder))
        if cfg.is_file():
            sources.setdefault(os.path.realpath(cfg), (folder, cfg))
    # …and every room's home on disk: it knows its project from «root» (written by start/init in
    # newer versions). One made before and not started since has none: its agents' folders are checked, an
    # agent with no folder of its own is not, until its next start.
    for cfg in room_home(Path("/")).parent.glob("*/.collab.json"):
        root = _plain_json(cfg).get("root")
        sources.setdefault(os.path.realpath(cfg), (root if isinstance(root, str) and os.path.isabs(root) else "", cfg))
    out: list[tuple[str, str]] = []
    for room_dir, cfg in sources.values():
        listed = [p for p in _plain_json(cfg).get("participants", []) if isinstance(p, dict) and isinstance(p.get("id"), str)]
        chosen = [p for p in listed if agent is None or agent(p)]
        if room_dir and (agent is None or chosen):
            out.append(("", room_dir))
        for p in chosen:
            who = str(p.get("label") or p["id"])
            if isinstance(p.get("folder"), str) and os.path.isabs(p["folder"]):
                out.append((who, p["folder"]))
            elif room_dir and isinstance(p.get("cwd"), str):
                # start runs it in ROOT / cwd — «../..» is above the project.
                out.append((who, os.path.normpath(Path(room_dir) / p["cwd"])))
    return out


def agent_folders() -> list[str]:
    """Every room's project folder and every agent's folder this computer knows of."""
    return [folder for _, folder in agent_workplaces()]


if sys.version_info < (3, 11):
    _py = recorded_python()
    if _py and os.environ.get("COLLAB_REEXEC") != _py:
        os.environ["COLLAB_REEXEC"] = _py  # once: a recorded old Python must not loop
        # -I -S: no PYTHON* settings, no user or site packages, not this folder on the path — only
        # the interpreter's own standard library (collab needs nothing else).
        os.execv(_py, [_py, "-I", "-S", os.path.realpath(__file__), *sys.argv[1:]])
    if sys.argv[1:2] != ["install"]:  # install still runs: it is what finds a newer one
        sys.exit(
            f"collab needs Python 3.11 or newer (this is {sys.version.split()[0]}, {sys.executable}).\n"
            "Run: collab install — it finds or installs one."
        )
else:
    # Handed over: the guard is for that one step. Left in the environment, a tmux server this collab
    # starts kept it, and every room window's «python3 collab» (3.9 again) took it for a loop and quit —
    # a new room without windows.
    os.environ.pop("COLLAB_REEXEC", None)


# ── commands ───────────────────────────────────────────────────────────────────

SELF = str(Path(__file__).resolve())


TEMP_PREFIXES: tuple[str, ...] = tuple(os.environ.get("COLLAB_TEMP_PREFIXES", ":".join(TEMP_FOLDERS)).split(":"))


def recent_folders(limit: int = 8) -> list[str]:
    """Folders where Claude Code or Codex was recently started — newest first, existing only,
    temporary ones left out. Read from the agents' own history, so /add offers a choice instead
    of a typed path. COLLAB_CLAUDE_HOME / COLLAB_CODEX_HOME point tests elsewhere."""
    seen: list[tuple[float, str]] = []
    claude_home = Path(os.environ.get("COLLAB_CLAUDE_HOME", "~/.claude")).expanduser() / "projects"
    try:
        projects = sorted(claude_home.iterdir(), key=lambda d: d.stat().st_mtime, reverse=True)[:25]
    except OSError:
        projects = []
    for proj in projects:
        try:
            newest = max(proj.glob("*.jsonl"), key=lambda f: f.stat().st_mtime)
        except (ValueError, OSError):
            continue
        try:
            with newest.open(encoding="utf-8", errors="replace") as fh:
                for _, raw in zip(range(300), fh):
                    m = re.search(r'"cwd":"((?:[^"\\]|\\.)*)"', raw)
                    if m:
                        seen.append((newest.stat().st_mtime, json.loads(f'"{m.group(1)}"')))
                        break
        except (OSError, ValueError):  # an escape JSON does not know: that file is skipped
            continue
    codex_home = Path(os.environ.get("COLLAB_CODEX_HOME", os.environ.get("CODEX_HOME", "~/.codex"))).expanduser()
    files: list[Path] = []
    for day in sorted((codex_home / "sessions").glob("*/*/*"), reverse=True):
        files += sorted(day.glob("*.jsonl"), reverse=True)
        if len(files) >= 40:
            break
    for f in files[:40]:
        try:
            with f.open(encoding="utf-8", errors="replace") as fh:
                cwd = json.loads(fh.readline()).get("payload", {}).get("cwd")
            # Another program's file, so any JSON: only a path is a folder (a number raised).
            if isinstance(cwd, str) and cwd and "\0" not in cwd:
                seen.append((f.stat().st_mtime, cwd))
        except (OSError, ValueError, AttributeError):
            continue
    out: list[str] = []
    for _, cwd in sorted(seen, key=lambda x: x[0], reverse=True):
        if "\0" in cwd or cwd in out or (cwd + "/").startswith(TEMP_PREFIXES) or not Path(cwd).is_dir():
            continue
        out.append(cwd)
        if len(out) >= limit:
            break
    return out

import datetime as dt
import os
import re
import sys
import time
import unicodedata
from pathlib import Path


ROOM = "room"
SPECIAL = {"all"}


def at_time(at: str) -> float:
    """A record's «at» as a timestamp; one that can't be read counts as long ago."""
    try:
        return dt.datetime.fromisoformat(at).timestamp()
    except ValueError:
        return 0.0


def local_hm(stamp: str) -> str:
    """Stored in UTC, shown in this computer's time zone (the room showed UTC)."""
    try:
        return dt.datetime.fromisoformat(stamp).astimezone().strftime("%H:%M")
    except ValueError:
        # Written straight into the log, `at` is anyone's text: five of its characters were enough to
        # hide what follows on the person's screen.
        return visible(str(stamp)[11:16])


def body_text(text: str) -> str:
    """A message's text as it is shown: every «→» in it is drawn «->» — only the room draws a head
    with «→». An agent's say faked a whole message of the person's in inbox and in its window;
    matching only «[a → b]» was passed by a no-break space the window then joined."""
    return visible(text).replace("→", "->")


# The words that address everyone. A name can't be one of them, and they win over any name: an
# agent called «Everyone» got the person's messages to everyone alone.
EVERYONE = {"all": "all", "всем": "all", "все": "all", "everyone": "all"}


def pasted_text(literal: str) -> str:
    """A paste as text: its line breaks one «\\n», a Tab a space, control codes out — they were taken for
    keys, and in the /dm panel went raw into the person's own input line."""
    # Not only what is below a space: DEL and the C1 controls too — «\x9b» is a CSI some terminals act on.
    return "".join(
        c
        for c in literal.replace("\r\n", "\n").replace("\r", "\n").replace("\t", " ")
        if c == "\n" or (c >= " " and not "\x7f" <= c <= "\x9f")
    )


def use_color() -> bool:
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def colours_only(line: str) -> str:
    """A line of another program's screen with its colours (SGR) and nothing else: links, titles,
    cursor moves and other control codes dropped."""
    # OSC (links, titles) whole first — a colour code inside one was taken for the line's own.
    line = re.sub(r"\033\].*?(?:\007|\033\\|$)", "", line.replace("\0", ""), flags=re.S)
    keep = [m.group(0) for m in ANSI.finditer(line)]
    marked = ANSI.sub("\0", line)  # SGR aside for a moment, so the sweep below cannot touch it
    marked = re.sub(r"\033\[[0-9;?<>=!]*[ -/]*[@-~]|\033.?", "", marked)
    marked = "".join(c for c in marked if c == "\0" or unicodedata.category(c) not in ("Cc", "Cf"))
    out = iter(keep)
    return "".join(next(out, "") if c == "\0" else c for c in marked)


def visible(text: str) -> str:
    """Only what is meant to be read: terminal control codes (ESC sequences could repaint the
    feed — erase a ⚠ mark, draw a fake «Anna →» — or, typed into an agent's window, act as
    key presses) and invisible format characters (direction overrides, zero widths) are dropped;
    tabs become spaces, line breaks stay."""
    text = (text or "").replace("\t", " ")
    return "".join(ch for ch in text if ch == "\n" or unicodedata.category(ch) not in ("Cc", "Cf"))


def paint(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m" if use_color() else text


ANSI = re.compile(r"\033\[[0-9;]*m")


def wrap_kept(line: str, width: int) -> list[str]:
    """wrap_visible, the line's indent kept on every piece: a message shown wide and drawn again in a
    narrower window (a /dm panel opened beside the chat) had its body's tails at column 0, where only a
    head begins."""
    plain = ANSI.sub("", line)
    indent = len(plain) - len(plain.lstrip(" "))
    if not indent or indent >= width - 1 or text_cols(plain) <= width:
        return wrap_visible(line, width)
    cut, codes = 0, ""
    for _ in range(indent):  # the indent's spaces themselves, past any colour code before them
        while m := ANSI.match(line, cut):
            codes, cut = codes + m.group(0), m.end()
        cut += 1
    return [codes + " " * indent + piece for piece in wrap_visible(line[cut:], width - indent)]


def wrap_visible(line: str, width: int) -> list[str]:
    """Split a line into pieces of at most `width` visible characters, keeping colour codes
    with the text they colour. Words stay whole when possible; nothing is ever dropped."""
    # In columns, not characters: «日本» is four, and a line of them ran past the window and over
    # the status rows.
    if text_cols(ANSI.sub("", line)) <= width:
        return [line]
    pieces: list[str]
    pieces, cur, cur_w, i = [], "", 0, 0
    while i < len(line):
        m = ANSI.match(line, i)
        if m:
            cur += m.group(0)
            i = m.end()
            continue
        cw = char_cols(line[i], line[i - 1] if i else "")
        if cur_w + cw > width and cur_w:
            pieces.append(cur)
            cur, cur_w = "", 0
        cur += line[i]
        cur_w += cw
        i += 1
    if cur:
        pieces.append(cur)
    return pieces


# Letters that look alike across Latin, Cyrillic and Greek: «Aнна» with a Latin A must count as
# «Анна» (the name check and the eye read names differently).
_LOOKALIKE = str.maketrans("аеорсухкмнтвіјѕԁԛԝаАЕОРСУХКМНТВІЈЅαοερτυνικμηχβ", "aeopcyxkmhtbijsdqwaaeopcyxkmhtbijsaoeptuvikmnxb")


def name_problem(name: str) -> str:
    """Why a name can't be used, or "": no control or invisible characters, and letters of one
    script — «Aндрей» mixing a Latin A into Cyrillic is how a borrowed name hides."""
    if visible(name) != name or "\n" in name:
        return "a name can't contain control or invisible characters"
    scripts = {unicodedata.name(ch, "?").split()[0] for ch in name if ch.isalpha()}
    if len(scripts) > 1:
        return f"a name uses one alphabet, not several ({', '.join(sorted(scripts)).lower()})"
    if not name.strip():
        return "a name can't be empty"
    if name_skeleton(name) in {name_skeleton(word) for word in EVERYONE}:
        return "that word means everyone in the room"
    return ""


def name_skeleton(name: str | None) -> str:
    """A name as the eye sees it: compatibility forms folded, invisible and joining marks, spaces
    and punctuation dropped, case and look-alike letters merged."""
    text = unicodedata.normalize("NFKD", name or "")
    kept = "".join(ch for ch in text if unicodedata.category(ch)[0] in "LN")
    return kept.casefold().translate(_LOOKALIKE)


def slug(label: str, taken: list[str], fallback: str) -> str:
    """A short latin id from a name: «Бэкенд» → bekend, never a taken one. A letter may become several:
    «Яна» was «ana» and «Юра» «ura», я and ю lost their «y». Ids already given stay."""
    table = str.maketrans(
        {
            "а": "a",
            "б": "b",
            "в": "v",
            "г": "g",
            "д": "d",
            "е": "e",
            "ё": "yo",
            "ж": "zh",
            "з": "z",
            "и": "i",
            "й": "y",
            "к": "k",
            "л": "l",
            "м": "m",
            "н": "n",
            "о": "o",
            "п": "p",
            "р": "r",
            "с": "s",
            "т": "t",
            "у": "u",
            "ф": "f",
            "х": "kh",
            "ц": "ts",
            "ч": "ch",
            "ш": "sh",
            "щ": "shch",
            "ъ": "",
            "ы": "y",
            "ь": "",
            "э": "e",
            "ю": "yu",
            "я": "ya",
            "і": "i",
            "ї": "yi",
            "є": "ye",
            "ґ": "g",
        }
    )
    base = re.sub(r"[^a-z0-9_-]+", "", label.lower().translate(table).replace(" ", "-"))[:16] or fallback
    pid, n = base, 2
    # Not a word that already means someone: «everyone» is how the chat says «all» (aliases), and
    # «owner» is the person's seat in most rooms. Only for new ids — SPECIAL itself is
    # what say accepts as a recipient, and «everyone» there would send to nobody. Nor the room's own
    # windows: an agent's window is named by its id, and two «deliver» windows hide the deliverer's.
    while pid in taken or pid in SPECIAL | {ROOM, "everyone", "owner", "deliver"}:
        pid, n = f"{base}{n}", n + 1
    return pid


def tilde(path: str) -> str:
    """A path to show: a folder's name is anybody's text — ESC in it repainted the person's screen
    from the /add menu."""
    home = str(Path.home())
    path = "~" + path[len(home) :] if path == home or path.startswith(home + "/") else path
    return visible(path).replace("\n", " ")


def clean_field(text: str, limit: int) -> str:
    """A model name or a state detail comes from the agent itself (or its transcript): no control
    codes into the person's terminal through the status line."""
    return " ".join(visible(text or "").split())[:limit]


def age(since: str) -> str:
    """«12s», «3m», «1h5m» since an ISO time; "" when unknown."""
    try:
        sec = max(0, int(time.time() - dt.datetime.fromisoformat(since).timestamp()))
    except (TypeError, ValueError):
        return ""
    return f"{sec}s" if sec < 60 else f"{sec // 60}m" if sec < 3600 else f"{sec // 3600}h{sec % 3600 // 60}m"


def char_cols(c: str, prev: str = "") -> int:
    """Terminal columns of one character: wide (CJK, most emoji) two, combining marks none. The emoji
    selector after a narrow sign makes it an emoji, two columns as tmux draws it («⚠️»): one more —
    counted as one, the line ran a column past the /dm panel and the terminal moved its last letter
    down alone."""
    if c == "\ufe0f":
        return 1 if prev and char_cols(prev) == 1 else 0
    if unicodedata.combining(c) or unicodedata.category(c) in ("Mn", "Me"):
        return 0
    if "\u1160" <= c <= "\u11ff" or "\ud7b0" <= c <= "\ud7ff":
        return 0  # a Hangul vowel or final of a jamo syllable joins the initial: «한» of three is two
    return 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1


def text_cols(text: str) -> int:
    """Terminal columns of plain text: wide characters count two."""
    return sum(char_cols(c, prev) for prev, c in zip(" " + text, text))


def wrap_cols(text: str, width: int) -> list[str]:
    """Words into lines of at most `width` columns, as textwrap would but in columns: a line of
    «日本» went past the window. A word wider than a line — CJK has no spaces — is cut."""
    # The spaces as written: the line's indent and those between words — code, a table, a command to copy
    # lost them (a regression of c7d4258; textwrap kept them). Only at a break they go.
    lines: list[str] = []
    cur, gap = "", ""
    for token in re.findall(r" +|[^ ]+", text):
        if token.startswith(" "):
            if cur or lines:
                gap = token
            elif text_cols(token) < width:
                cur = token  # the indent of the line; wider than the line, it would leave it empty
            continue
        word = token
        while text_cols(word) > width:
            if cur.strip():
                lines.append(cur.rstrip())
            cur, gap = "", ""
            piece = cut_cols(word, width) or word[0]
            lines.append(piece)
            word = word[len(piece) :]
        joined = cur + gap + word
        if text_cols(joined) <= width:
            cur = joined
        else:
            lines.append(cur.rstrip())
            cur = word
        gap = ""
    if cur.strip():
        lines.append(cur.rstrip())
    return lines


def cut_cols(text: str, n: int, from_end: bool = False) -> str:
    """The longest start (or end) of plain text that fits `n` columns — never half a wide character."""
    out: list[str]
    out, used = [], 0
    for c in reversed(text) if from_end else text:
        cw = char_cols(c, "" if from_end or not out else out[-1])
        if used + cw > n:
            break
        out.append(c)
        used += cw
    return "".join(reversed(out) if from_end else out)


def status_cell(mark: str, name: str, state: str, model: str, since: str, width: int) -> str:
    """One agent's cell, exactly `width` columns: mark and name (and the state word) on the left, the
    model and the working time on the right. Short of room, given up in this order:
    the space in «↻ 2»; the name, down to four letters and «…»; the state word — the name gives way
    before it; the time; the model last, with «…». The mark and the count never go."""

    def fits(left: str, right: str) -> bool:
        return text_cols(left) + (1 + text_cols(right) if right else 0) <= width

    def named(mark_: str, tail: str, right: str) -> str:
        """The name as long as it fits beside the rest; "" when not even four letters and «…» do."""
        space = width - text_cols(mark_) - 1 - text_cols(tail) - (text_cols(right) + 1 if right else 0)
        if text_cols(name) <= space:
            return f"{mark_} {name}{tail}"
        return f"{mark_} {fit_cols(name, space).rstrip()}{tail}" if space >= 5 else ""

    full = " ".join(x for x in (model, since) if x)
    tail = f": {state}" if state else ""
    for mark_, tail_, right in ((mark, tail, full), (mark.replace(" ", ""), tail, full)):
        if fits(f"{mark_} {name}{tail_}", right):
            return spread(f"{mark_} {name}{tail_}", right, width)
    mark_ = mark.replace(" ", "")
    for tail_, right in ((tail, full), ("", full), ("", model)):
        left = named(mark_, tail_, right)
        if left:
            return spread(left, right, width)
    left = f"{mark_} {fit_cols(name, 5).rstrip()}"
    space = width - text_cols(left) - 1
    return spread(left, fit_cols(model, space).rstrip() if space >= 2 else "", width)


def spread(left: str, right: str, width: int) -> str:
    """`left` at the left edge, `right` at the right, exactly `width` columns. Short of room the
    right side (model, time) is cut first down to a few letters, then the left (name)."""
    if text_cols(left) + 1 + text_cols(right) > width:
        right = fit_cols(right, max(0, min(text_cols(right), width - min(text_cols(left), 10) - 1))).rstrip()
        left = fit_cols(left, width - (text_cols(right) + 1 if right else 0)).rstrip()
    return left + " " * max(1 if right else 0, width - text_cols(left) - text_cols(right)) + right


def fit_cols(text: str, width: int) -> str:
    """Exactly `width` terminal columns: cut with «…» or padded. Wide characters count two."""
    cols = text_cols
    out, used = "", 0
    for i, c in enumerate(text):
        rest = sum(cols(x) for x in text[i:])
        if used + rest <= width:
            return out + text[i:] + " " * (width - used - rest)
        if used + cols(c) + 1 > width:
            return out + "…" + " " * (width - used - 1)
        out, used = out + c, used + cols(c)
    return out + " " * (width - used)


def until_hm(until: float) -> str:
    """When a limit ends: «00:42» today, «23.11 00:42» another day — «until 00:42» read late in the
    evening looked like a time already past."""
    at = dt.datetime.fromtimestamp(until)
    return at.strftime("%H:%M") if at.date() == dt.date.today() else at.strftime("%d.%m %H:%M")

import os
import shutil
import sys
from typing import Any, Callable



def ask_line(prompt: str) -> str:
    """input() that survives a terminal without UTF-8 line editing (macOS Terminal often): there
    Backspace erases one byte of a Cyrillic letter, the other byte stays, and writing the name
    crashed the room's creation with «surrogates not allowed» (earlier the stray
    letters «АФ» in the name were the same thing). readline erases whole letters; whatever broken
    bytes still come through are dropped. Raises EOFError like input()."""
    try:
        import readline  # noqa: F401  # pyright: ignore[reportUnusedImport] — importing it gives input() letter-wise editing
    except ImportError:
        pass
    raw = input(prompt)
    return raw.encode("utf-8", "surrogateescape").decode("utf-8", "ignore")


def confirm(question: str) -> bool:
    """A yes/no in the terminal, chosen with arrows like everything else («all from the
    menu, yes and no too; the line only for what must be typed»). No is first and is what Esc
    means: a question that guards a stop or a clear must be hard to answer yes by accident."""
    return pick([question], [("No", False), ("Yes", True)], ["↑/↓ choose · Enter · Esc — No"]) is True


def pick(intro: list[str], rows: list[tuple[str, Any]], outro: list[str], erase: Any = False) -> Any:
    """A column chosen with arrows and Enter; returns the chosen row's value, or None on Esc/q
    or without a terminal. Rows whose value is None are group titles: shown, never selected.
    Each row is cut to the window width — a long path wrapped onto two lines and the redraw
    left copies of rows behind. A list taller than the window scrolls with the
    choice (a folder of 40 projects). `erase` (True, or a test of the chosen value): the menu leaves
    no trace — the next one takes its place."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    import select
    import termios
    import tty

    fd = sys.stdin.fileno()
    pickable = [k for k, (_, v) in enumerate(rows) if v is not None]
    if not pickable:
        return None
    sel = 0
    width = max(20, shutil.get_terminal_size((80, 24)).columns - 1)
    # Cut the middle, not the end: the end of a path is the folder's name, the one thing that
    # tells two long paths apart (two rooms showed as the same «…/T/tmpn…»).
    fit: Callable[[str], str] = lambda t: t if len(t) <= width else t[: width // 2 - 1] + "…" + t[-(width - width // 2) :]
    old = termios.tcgetattr(fd)
    for line in intro:
        print(fit(line))
    height = max(3, shutil.get_terminal_size((80, 24)).lines - len(intro) - len(outro) - 1)
    shown = min(len(rows), height)

    def draw(first: bool) -> None:
        if not first:
            sys.stdout.write(f"\033[{shown + len(outro)}A")
        start = max(0, min(pickable[sel] - shown // 2, len(rows) - shown))
        for k, (label, value) in list(enumerate(rows))[start : start + shown]:
            if value is None:
                text = paint(fit(label), "2")
            elif k == pickable[sel]:
                text = paint(fit(f" › {label}"), "1")
            else:
                text = fit(f"   {label}")
            sys.stdout.write("\r\033[2K" + text + "\n")
        for line in outro:
            sys.stdout.write("\r\033[2K" + paint(fit(line), "2") + "\n")
        sys.stdout.flush()

    chosen = None
    try:
        tty.setcbreak(fd)
        draw(True)
        while True:
            ch = os.read(fd, 1)
            if ch == b"\x1b":
                seq = os.read(fd, 2) if select.select([fd], [], [], 0.05)[0] else b""
                # Arrows come as ESC [ A or, in a terminal's application-cursor mode (macOS
                # Terminal), as ESC O A.
                if seq in (b"[A", b"OA"):
                    sel = (sel - 1) % len(pickable)
                elif seq in (b"[B", b"OB"):
                    sel = (sel + 1) % len(pickable)
                elif not seq:
                    return None
                draw(False)
            elif ch in (b"\r", b"\n"):
                chosen = rows[pickable[sel]][1]
                return chosen
            elif ch in (b"q", b"\x03", b"\x04"):
                return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if erase is True or (callable(erase) and erase(chosen)):
            sys.stdout.write(f"\033[{len(intro) + shown + len(outro)}A\r\033[J")
            sys.stdout.flush()

