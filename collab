def cmd_add(args: argparse.Namespace) -> None:
    """`collab add`: what /add in the chat does, from a command line — a room set up to the end by a
    script or another agent. The room must be running: the agent gets a window of its session."""
    config = load_config()
    session = config.get("session", "collab-room")
    if tmux("has-session", "-t", f"={session}", check=False).returncode != 0:
        fail(tr("the room is not running — collab start first, then collab add"))
    try:
        folder = Path(args.folder or str(room().paths.root)).expanduser()
    except RuntimeError:  # «~someone» with no such user
        fail(tr("Folder not found: {folder}", folder=args.folder))
    problem = folder_problem(folder)
    if problem:
        fail(problem)
    base = PRESETS[args.kind]["label"]
    label = args.name or next(
        n for n in [base] + [f"{base} {i}" for i in range(2, 100)] if not label_taken(config, "", n)
    )
