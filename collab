def chat_append(ctx: ChatFeedContext, text: str, remember: bool = True) -> None:
    """Append text to the scrolling feed, above the fixed area."""
    if not ctx.tty:
        print(text, flush=True)
        return
    if remember:
        ctx.feed_log.extend(text.split("\n"))
        ctx.blocks.append(text.split("\n"))
        if ctx.ui.top is None:
            del ctx.feed_log[:-5000]
            del ctx.blocks[:-1000]
    if ctx.ui.top is not None:
        if remember:
            ctx.ui.unseen += 1  # new ones wait at the bottom; the person is not pulled out of history
            ctx.draw_history()
        return
    if ctx.ui.viewing or ctx.ui.reading:
        return  # the agent's screen or a message from /mine is on show; the feed catches up (repaint)
    h, w = ctx.rows(), shutil.get_terminal_size((100, 24)).columns
    sys.stdout.write(ctx.feed_frame(text, h, w))
    sys.stdout.flush()


def chat_old_versions(ctx: ChatFeedContext) -> list[str]:
    """Said once each: this chat runs an older collab — what it starts would get
    yesterday's rules; a Codex runs an older copy — a restart gives it the new one."""
    lines = []
    if ctx.stale_chat() and "chat" not in ctx.told_old:
        ctx.told_old.add("chat")
        lines.append(ctx.STALE_CHAT)
    with contextlib.suppress(OSError):
        now_name = current_name()
        for q in ctx.config.get("participants", []):
            cli = str(q.get("cli") or "")
            if q.get("kind") == "codex" and cli and Path(cli).name != now_name and (q["id"], cli) not in ctx.told_old:
                ctx.told_old.add((q["id"], cli))
                who = label_of(ctx.config, q["id"])
                lines.append(tr("· {who} runs an older collab — /restart {who_} when convenient.", who=who, who_=who))
    return lines


def chat_states(ctx: ChatFeedContext) -> list[str]:
    """Calm states to the bar; what needs the person (a question, a lost window, unsent text)
    also goes into the feed, once."""
    out, parts, cells = [], [], []
    out += [paint(x, "38;5;214") for x in ctx.old_versions()]
    st = read_status()
    for pid in ctx.known:
        if pid == ctx.args.as_ or pid not in st:
            continue
        line = visible(describe(pid, st[pid], ctx.args.stale))  # English: what the chat reads
        shown_line = visible(describe(pid, st[pid], ctx.args.stale, room_language(ctx.config)))
        state = st[pid].get("state", "")
        # The bottom line speaks English; messages in the feed stay as they are.
        # An unknown state from status.json is shown cleaned: it may come from an agent.
        short = BAR_WORDS.get(state) or clean_field(str(state), 20)
        if any(q["id"] == pid and q.get("muted") for q in ctx.config["participants"]):
            short = "Muted"
        if "No update for" in line:
            short = "No update"
        # Every state a filled badge, black bold letters — green Ready, yellow Working,
        # orange Muted (and out of limit), red: act in the agent's window; light grey: no data.
        # Working's mark turns — the eye catches motion; the others carry a sign, not only colour.
        mark = SPINNER[int(time.time() * 4) % len(SPINNER)] if short == "Working" else BAR_MARKS.get(short, " ")
        since = age(st[pid].get("since", "")) if short == "Working" else ""
        # Cleaned again on show: status.json written before the fix may hold codes already.
        # Out of limit, the cell shows when it is back instead of the model.
        right = st[pid].get("detail", "") if state == "limited" else st[pid].get("model", "")
        bg = re.fullmatch(r"background (\d+)", str(st[pid].get("detail", "")))
        if bg and short == "Ready":
            # Ready for messages, its own commands run in the background: green, and
            # how many by the mark; the model stays where it is («it hid the model»). The
            # spinner too — work goes on — and the clock does not stop: it counts from the earliest
            # background command still running (bg_since), not from when it became Ready.
            mark = SPINNER[int(time.time() * 4) % len(SPINNER)] + " " + bg.group(1)
            since = age(st[pid].get("bg_since") or st[pid].get("since", ""))
        cells.append(
            (label_of(ctx.config, pid), clean_field(right, 40), short, mark, since, BAR_FILL.get(short, 250))
        )
        # «No update for 40 min», «41 min»…: the same news, not a new line in the feed every minute.
        news = re.sub(r"No update for \d+ min", "No update", line)
        if ctx.shown_state.get(pid) != news:
            ctx.shown_state[pid] = news
            if state in ("needs_owner", "lost", "draft"):
                out.append(paint(shown_line.replace(pid, label_of(ctx.config, pid), 1), "1;38;5;196"))
    if ctx.stale_chat():
        # Kept in the bar while it lasts: said once in the feed, it scrolled away, and the person took a chat that
        # lacked /team and /telegram for the room's own.
        parts.insert(0, paint(tr("Old chat — reopen: /exit, then collab"), "1;38;5;214"))
    if load_config().get("paused"):
        n = held_count()
        parts.insert(0, paint(tr("Paused") + (tr(" · {n} waiting", n=n) if n else ""), "1;38;5;214"))
    rows_ = ctx.status_bar_rows(cells, parts, shutil.get_terminal_size((100, 24)))
    ctx.ui.extra_rows = len(rows_) - 1
    ctx.ui.bar = "\n".join(rows_)
    return out


def chat_fold_into_dm(ctx: ChatFeedContext, m: dict[str, Any]) -> bool:
    """While an agent's /dm tab is open, its strictly private letters to the person go there; the
    feed keeps one line that is updated, not repeated: «· Ann ⇄ Bob in /dm · 3 new».
    Never a letter to others too, never one «from the person» the chat did
    not sign — that one is shown whole with its ⚠."""
    rp = room().paths
    if (
        not ctx.dm_focus[0]
        or m["to"] != [ctx.args.as_]
        or m["from"] in (ctx.args.as_, ROOM)
        or unsigned_person(m, ctx.config)
    ):
        return False
    agent = m["from"]
    if agent not in ctx.dm_tabs(ctx.args.as_)["tabs"]:
        return False
    read = read_set(rp.receipts_dir, ctx.args.as_)
    new = sum(1 for x in ctx.dm_talk(read_messages(), ctx.args.as_, agent) if x["from"] == agent and x["id"] not in read)
    text = paint(
        tr("· {me} ⇄ {p1} in /dm · {new} new", me=ctx.me, p1=label_of(ctx.config, agent), new=new)
        if new
        else tr("· {me} ⇄ {p1} in /dm", me=ctx.me, p1=label_of(ctx.config, agent)),
        "2",
    )
    if ctx.folded[0] == agent and ctx.blocks and ctx.blocks[-1] is ctx.folded[1]:
        # The same talk again, nothing in between: that line is updated, not another one added.
        old = len(ctx.folded[1])
        ctx.folded[1][:] = [text]
        del ctx.feed_log[-old:]
        ctx.feed_log.append(text)
        ctx.repaint()
    else:
        ctx.feed(text)
        ctx.folded[0], ctx.folded[1] = agent, ctx.blocks[-1] if ctx.blocks else None
    return True


def chat_pump(ctx: ChatFeedContext) -> None:
    last_bar, last_rows = None, ctx.ui.laid
    said: set[str] = set()  # each trouble once, not every tick

    def trouble(text: str) -> None:
        if text not in said:
            said.add(text)
            ctx.feed(paint(text, "1;38;5;196"))

    while not ctx.stop.wait(ctx.args.interval):
        with ctx.lock:
            if ctx.refresh_people() and ctx.tty:
                ctx.ui.redraw_input()
            with contextlib.suppress(Exception):
                seen_focus = list(ctx.dm_focus)
                ctx.dm_focus[0] = ctx.dm_window_alive(ctx.args.as_)
                ctx.dm_focus[1] = (
                    tmux(
                        "display-message", "-p", "-t", os.environ.get("TMUX_PANE", ""), "#{pane_active}", check=False
                    ).stdout.strip()
                    != "0"
                )
                if ctx.dm_focus != seen_focus and ctx.tty and not ctx.wizard():
                    ctx.ui.redraw_input()
            # The log, once a tick: for «● N for you» and for the feed both. Only what came since is read
            # (the tick's reader): the whole 4 MB log every tick was the chat's CPU. The feed
            # judges each message once, when it first shows it; the past is read whole where it is judged
            # again — history, /mine, a reply by id.
            try:
                tick_log: list[dict[str, Any]] | None = read_log_tick()
            except OperationFailed as exc:  # a link in the log: said once, the feed goes on
                trouble(tr("! {exc}", exc=exc))
                tick_log = None
            with contextlib.suppress(Exception):
                before = ctx.ui.mine_count
                if tick_log is not None:
                    ctx.count_mine(tick_log)
                if ctx.ui.mine_count != before and ctx.tty and not ctx.wizard():
                    ctx.ui.redraw_input()
            # The window was resized — its width too: a /dm panel beside the chat took a third of it,
            # and the old draft hint stayed over the input — rebuild the fixed area.
            if ctx.tty and (ctx.rows(), shutil.get_terminal_size((100, 24)).columns) != last_rows:
                last_rows = (ctx.rows(), shutil.get_terminal_size((100, 24)).columns)
                ctx.repaint()
                last_bar = None
            # A record or a status no part of the chat can show is said once, and the feed goes on:
            # it used to end the feed thread in silence.
            # An open menu sits over the bottom of the feed: what comes in now would scroll it up
            # with the feed. It waits — the states line still updates — and is
            # printed on the first tick after the menu closes.
            hold = bool(ctx.ui.popup)
            try:
                ctx.held_alerts.extend("\n" + alert for alert in ctx.states())
            except Exception as exc:  # noqa: BLE001
                trouble(tr("! Could not read the agents' states: {exc}", exc=repr(exc)))
            while ctx.held_alerts and not hold:
                ctx.feed(ctx.held_alerts.pop(0))
            log = [] if hold or tick_log is None else tick_log
            for m in log:
                if m["id"] not in ctx.printed:
                    ctx.printed.add(m["id"])
                    # Your own words were shown as you typed them; one in your name that
                    # this chat did not send is shown, marked.
                    try:
                        if ctx.fold_into_dm(m):
                            continue
                        if m["from"] != ctx.args.as_ or unsigned_person(m, ctx.config):
                            ctx.feed(ctx.show(m))
                    except Exception as exc:  # noqa: BLE001
                        trouble(tr("! Could not show message {p0}: {exc}", p0=visible(m["id"]), exc=repr(exc)))
            # A proposal for the team waiting for the person: its card opens by itself when no question is open —
            # one Enter applies it. Each once: «Later» leaves it to /team. By the room's record of proposals, which
            # delivery fills — not by the tick's messages, which may come before it is judged.
            if ctx.tty and not ctx.wizard() and not ctx.ui.popup and ctx.args.as_ in people_ids(ctx.config):
                try:
                    shown = ctx.ui.proposals_shown
                    waiting = [k for k, v in proposal_state().items() if v == "pending" and k not in shown]
                    everything = read_messages() if waiting else []
                    at = next((i for i, x in enumerate(everything) if x.get("id") == waiting[0]), -1) if waiting else -1
                    # What came after the proposal and is not on the screen yet goes first, on the next tick: a card
                    # opened over it held it back, and it poured out after the person's answer, over the answer's
                    # own line.
                    if waiting and not any(x.get("id") not in ctx.printed for x in everything[at + 1 :]):
                        shown.add(waiting[0])  # the rest open one by one, each when no question is open
                        m = everything[at] if at >= 0 and isinstance(everything[at].get("proposal"), dict) else None
                        if m is not None:
                            cfg = load_config()
                            req = request_of(m, cfg, everything) or {}  # only the person's own request is shown as one
                            ctx.feed(paint(proposal_words(cfg, m["proposal"]), "38;5;252") + "\n" * 5)
                            ctx.wizard().update(proposal_card(m, cfg, str(req.get("text") or "")))
                            ctx.ui.redraw_input()
                except Exception as exc:  # noqa: BLE001
                    trouble(tr("! Could not show a proposal: {exc}", exc=repr(exc)))
            while sink := chat_mode().sink:
                ctx.feed(paint(sink.pop(0), "38;5;245"))
            if ctx.ui.viewing:
                ctx.draw_view()
            if ctx.ui.bar != last_bar:
                last_bar = ctx.ui.bar
                ctx.draw_bottom()


def chat_refresh_people(ctx: ChatFeedContext) -> bool:
    """Pick up participants added while the seat is open (/add, join) without a restart."""
    rp = room().paths
    try:
        m = rp.config_path.stat().st_mtime
    except OSError:
        return False
    if m == ctx.ui.cfg_mtime:
        return False
    ctx.ui.cfg_mtime = m
    try:
        fresh = load_config()
    except (Exception, SystemExit) as exc:  # noqa: BLE001
        # One bad .collab.json (a participant with an unknown `delivery`) ended the feed's thread for
        # good, while the input still sent — the person wrote without seeing answers. Said
        # once per version of the file; the chat goes on with whom it had; a fixed file is read again.
        ctx.feed(
            paint(
                tr(
                    "! The room's settings can't be read: {p0} — the chat goes on with the participants it had; fix .collab.json and it reads them again.",
                    p0=clean_field(str(exc), 200),
                ),
                "1;38;5;196",
            )
        )
        return False
    ctx.config.clear()
    ctx.config.update(fresh)
    speak(room_language(ctx.config))  # a /language from another chat: this one follows
    ctx.known[:] = ids_of(ctx.config)
    ctx.names.clear()
    ctx.names.update(aliases(ctx.config))
    ctx.targets()[:] = ["all"] + [pid for pid in ctx.known if pid != ctx.args.as_]
    if ctx.ui.selected is not None and ctx.ui.selected not in ctx.targets():
        # The chosen recipient left. Do NOT fall back to Everyone: a private draft would leak
        # to the whole room on Enter. Ask for a new choice instead.
        ctx.ui.selected = None
        ctx.feed(
            paint(tr("! The recipient left the room — press Tab to choose who gets your message."), "1;38;5;196")
        )
    return True
"""The chat's keys: the loop that reads the terminal and turns what is typed into the draft,
the cursor, the menu's moves and the sending — moved out of cmd_chat as it was. What it needs of the
chat comes through ChatInputContext, as chat_cmds takes ChatCommandContext."""


import codecs
import os
from dataclasses import dataclass
from typing import Any





@dataclass
class ChatInputContext:
    """cmd_chat's objects and callbacks the key loop reads; each made once, before the loop."""

    after_lock: Any
    args: Any
    ask_exit: Any
    buf: Any
    choose_command: Any
    commands: Any
    dm_window: Any
    dm_window_alive: Any
    draw_reading: Any
    fd: Any
    feed: Any
    history: Any
    leave_history: Any
    lock: Any
    menu_items: Any
    render: Any
    repaint: Any
    slash_commands: Any
    step: Any
    stop_reading: Any
    stop_view: Any
    submit: Any
    ui: Any
    wizard: Any
    wizard_back: Any


def chat_read_keys(ctx: ChatInputContext) -> None:
    """Read the terminal until it ends, the chat closes or Ctrl+C; each key under the chat's lock."""
    decoder = codecs.getincrementaldecoder("utf-8")(errors="ignore")
    pending = ""
    in_paste = False
    PASTE_END = "\033[201~"
    while True:
        chunk = os.read(ctx.fd, 1024)
        if not chunk:
            return
        pending += decoder.decode(chunk)
        while pending:
            with ctx.lock:
                if ctx.ui.reading:
                    # One message of /mine on show: ↑/↓ the others, Enter or Esc back to the list;
                    # nothing typed reaches the draft.
                    if pending == "\033":
                        import select

                        if select.select([ctx.fd], [], [], 0.06)[0]:
                            break
                        pending = ""
                        ctx.stop_reading()
                        ctx.render()
                        continue
                    if pending.startswith(("\033[A", "\033[B", "\033OA", "\033OB")):
                        r = ctx.ui.reading
                        r["at"] = max(0, min(len(r["ids"]) - 1, r["at"] + (-1 if pending[2] == "A" else 1)))
                        pending = pending[3:]
                        ctx.draw_reading()
                        continue
                    if pending[:1] in ("\r", "\n"):
                        pending = pending[1:]
                        ctx.stop_reading()
                        ctx.render()
                        continue
                    if pending.startswith("\033[") and len(pending) < 3:
                        break
                    pending = pending[1:]
                    continue
                if ctx.ui.viewing:
                    # Read-only: nothing typed here reaches the agent or the draft. A lone Esc
                    # (not the start of an arrow's sequence) goes back to the chat.
                    if pending == "\033":
                        import select

                        if select.select([ctx.fd], [], [], 0.06)[0]:
                            break
                        ctx.stop_view()
                    elif "\033" in pending and not pending[pending.index("\033") + 1 :].startswith(("[", "O")):
                        ctx.stop_view()  # Esc arrived together with other keys: still back
                    pending = ""
                    continue
                if in_paste:
                    # A paste is text to its end: its Tab, Ctrl-C, Ctrl-U, Ctrl-D were taken for
                    # keys — a Tab inside sent a private draft to everyone.
                    end = pending.find(PASTE_END)
                    if end >= 0:
                        literal, pending, in_paste = pending[:end], pending[end + len(PASTE_END) :], False
                    else:
                        # Its end may come in two reads; a cut «\033[20» was eaten as a key and
                        # the chat stayed «in a paste», Enter sending nothing.
                        keep = next(
                            (
                                k
                                for k in range(min(len(PASTE_END) - 1, len(pending)), 0, -1)
                                if PASTE_END.startswith(pending[-k:])
                            ),
                            0,
                        )
                        literal, pending = pending[: len(pending) - keep], pending[len(pending) - keep :]
                    if literal and ctx.ui.suggested:
                        ctx.buf[:], ctx.ui.pos, ctx.ui.suggested = [], 0, False
                    for c in pasted_text(literal):
                        ctx.buf.insert(ctx.ui.pos, c)
                        ctx.ui.pos += 1
                    if literal:
                        ctx.ui.menu_closed = ctx.ui.menu_moved = False
                    if in_paste and pending:
                        break  # the rest of its end is coming
                    continue
                if pending.startswith("\033[200~"):
                    in_paste, pending = True, pending[6:]
                elif pending.startswith("\033[201~"):
                    pending = pending[6:]  # an end without a start: nothing
                elif pending.startswith(("\033\r", "\033\n")):  # Option+Enter: new line
                    ctx.buf.insert(ctx.ui.pos, "\n")
                    ctx.ui.pos += 1
                    pending = pending[2:]
                elif pending.startswith(("\033[13;2u", "\033[27;2;13~")):  # Shift+Enter where the terminal tells it apart
                    ctx.buf.insert(ctx.ui.pos, "\n")
                    ctx.ui.pos += 1
                    pending = (
                        pending[pending.index("u") + 1 :] if pending.startswith("\033[13;2u") else pending[len("\033[27;2;13~") :]
                    )
                elif pending.startswith("\033[Z"):  # Shift+Tab
                    ctx.step(-1)
                    pending = pending[3:]
                elif pending.startswith(("\033[A", "\033[B", "\033OA", "\033OB")):
                    up = pending[2] == "A"
                    items = ctx.menu_items()
                    if items:
                        ctx.ui.menu_index = (ctx.ui.menu_index + (-1 if up else 1)) % len(items)
                        if items[ctx.ui.menu_index][1] == "pick:sep:" and len(items) > 1:
                            # A heading of a list («Earlier for you») is never chosen: stepped over.
                            ctx.ui.menu_index = (ctx.ui.menu_index + (-1 if up else 1)) % len(items)
                        ctx.ui.menu_moved = True
                    elif up or ctx.ui.top is not None:
                        ctx.history(-1 if up else 1)  # no menu open: earlier messages
                    pending = pending[3:]
                # ←/→/Home/End also in the SS3 form (ESC O D): terminals in application cursor
                # mode send it, and «OD» went into the draft.
                elif pending.startswith(("\033[D", "\033OD")):
                    ctx.ui.suggested = False
                    ctx.ui.pos = max(0, ctx.ui.pos - 1)
                    pending = pending[3:]
                elif pending.startswith(("\033[C", "\033OC")):
                    ctx.ui.pos = min(len(ctx.buf), ctx.ui.pos + 1)
                    pending = pending[3:]
                elif pending.startswith(("\033[H", "\033OH", "\033[F", "\033OF")):
                    ctx.ui.pos = 0 if pending[2] == "H" else len(ctx.buf)
                    pending = pending[3:]
                elif pending.startswith("\033O") and len(pending) >= 3:
                    pending = pending[3:]  # any other SS3 key: ignored, never typed
                elif pending.startswith(("\033[5~", "\033[6~")):  # PgUp / PgDn: a page
                    ctx.history(-1 if pending[2] == "5" else 1, page=True)
                    pending = pending[4:]
                elif pending.startswith("\033[") and len(pending) >= 3:
                    # other escape sequences (arrows up/down, function keys): ignore
                    j = 2
                    while j < len(pending) and not ("@" <= pending[j] <= "~"):
                        j += 1
                    if j >= len(pending):
                        break  # cut between two reads: «\033[1;» then «5D» typed «5D»
                    pending = pending[j + 1 :]
                elif pending == "\033":
                    import select

                    if select.select([ctx.fd], [], [], 0.06)[0]:
                        break  # more is coming: an escape sequence
                    # A lone Esc: one step back, everywhere — a question goes
                    # to its previous step, then to the command menu; a name after /mute
                    # goes back to the commands; the command menu closes.
                    pending = ""
                    value = "".join(ctx.buf)
                    if ctx.ui.top is not None:
                        ctx.leave_history()
                    elif ctx.wizard:
                        ctx.wizard_back()
                    elif value.startswith("/") and " " in value:
                        cmd = value.split(" ", 1)[0]
                        ctx.buf[:] = list("/")
                        ctx.ui.pos = 1
                        ctx.ui.menu_index = next((i for i, (c, _) in enumerate(ctx.commands) if c == cmd), 0)
                        ctx.ui.menu_closed = False
                    elif value.startswith("/"):
                        ctx.buf.clear()
                        ctx.ui.pos = 0
                    else:
                        ctx.ui.menu_closed = True
                elif pending == "\033O" or (pending.startswith("\033[") and len(pending) < 3):
                    break  # wait for the rest of the sequence
                else:
                    ch, pending = pending[0], pending[1:]
                    was_back, ctx.ui.came_back = ctx.ui.came_back, False
                    was_suggested, ctx.ui.suggested = ctx.ui.suggested, False
                    if ch == "\x0f":  # Ctrl+O: to the /dm panel, the same key comes back
                        rec = ctx.dm_window(ctx.args.as_)
                        if rec and ctx.dm_window_alive(ctx.args.as_):
                            tmux("select-pane", "-t", rec["pane"], check=False)
                        else:
                            ctx.feed(paint(tr("No private-talk panel is open — /dm <name> opens one."), "38;5;252"))
                        ctx.render()
                        continue
                    if ch == "\x03":
                        try:
                            ctx.ask_exit()
                        except EOFError:
                            return
                    elif ch == "\t":
                        ctx.step(1)
                    elif (
                        ch in "\r\n"
                        and not in_paste
                        and ctx.menu_items()
                        and (ctx.ui.menu_moved or "".join(ctx.buf) not in ctx.slash_commands)
                    ):
                        to_send = ctx.choose_command()
                        if to_send is not None:
                            ctx.ui.popup = 0
                            ctx.repaint()
                            try:
                                ctx.submit(to_send)
                            except EOFError:
                                return
                    elif (
                        ch in "\r\n"
                        and not in_paste
                        and ctx.ui.selected is None
                        and ctx.buf
                        and not ctx.wizard
                        and not "".join(ctx.buf).lstrip().startswith(("/", "@"))
                    ):
                        # No recipient chosen: keep the draft, send nothing.
                        ctx.feed(
                            paint(tr("! Choose a recipient with Tab first — your text is kept."), "1;38;5;196")
                        )
                    elif ch in "\r\n" and not in_paste:
                        if ctx.buf and ctx.buf[-1] == "\\":
                            # «\» at the end of the line + Enter: a new line, not sending.
                            ctx.buf[-1] = "\n"
                            ctx.render()
                            continue
                        line = "".join(ctx.buf)
                        ctx.buf.clear()
                        ctx.ui.pos = 0
                        if ctx.ui.top is not None:
                            ctx.leave_history()  # what you send appears among the newest
                        try:
                            ctx.submit(line)
                        except EOFError:
                            return
                    elif ch in "\r\n":
                        ctx.buf.insert(ctx.ui.pos, "\n")
                        ctx.ui.pos += 1
                    elif ch in ("\x7f", "\x08"):
                        if was_suggested:
                            ctx.buf[:], ctx.ui.pos = [], 0
                        if ctx.ui.pos > 0:
                            ctx.ui.menu_closed = False
                            ctx.ui.menu_moved = False
                            del ctx.buf[ctx.ui.pos - 1]
                            ctx.ui.pos -= 1
                    elif ch == "\x15":  # Ctrl-U: clear the line
                        ctx.ui.menu_closed = False
                        ctx.ui.menu_moved = False
                        ctx.buf.clear()
                        ctx.ui.pos = 0
                    elif ch == "\x04" and not ctx.buf:  # Ctrl-D on an empty line: asks, as Ctrl-C
                        # It closed the chat without a word.
                        try:
                            ctx.ask_exit()
                        except EOFError:
                            return
                    elif ch >= " ":
                        if was_suggested:
                            ctx.buf[:], ctx.ui.pos = [], 0
                        ctx.ui.menu_closed = False
                        ctx.ui.menu_moved = False
                        if not ctx.buf and ch == "/":
                            ctx.ui.menu_index = 0
                        if ch == "/" and was_back and ctx.buf == ["/"]:
                            # Esc from a command's menu came back with «/»; the person
                            # types «/mine» from habit — «//mine» went to the agents as text.
                            # Only right after that step back: «//text» typed anew still
                            # sends text that starts with «/».
                            pass
                        else:
                            ctx.buf.insert(ctx.ui.pos, ch)
                            ctx.ui.pos += 1
                ctx.render()
        while ctx.after_lock:
            ctx.after_lock.pop(0)()

import argparse
import contextlib
import io
import os
import shlex
import shutil
import sys
import threading
import time
from pathlib import Path
from typing import Any




















def cmd_chat(args: argparse.Namespace) -> None:
    """A person's seat: the room scrolls above, a fixed bottom area holds states, a rule and the input.

    Layout, top to bottom at the end of the window: rule · input · states (the very last row,
    which also keeps the input off the bottom edge). The feed lives in
    a terminal scroll region above it, so incoming messages and state changes never leave copies
    of the bottom area in the history — the earlier "move the cursor up N lines" redraw did exactly
    that after every Enter and on wrapped lines. Without a terminal
    (pipes, tests) the seat falls back to plain line output.
    """
    inst = paths()
    rp = room().paths
    ui = ChatState()
    born = copy_name()  # the collab this chat runs, by its content
    ui.mine_count = 0  # «● N for you» over the input
    dm_focus = [False, True]  # a /dm panel is open beside this chat; the input is here
    folded: list[Any] = [None, None]  # the agent whose /dm line is the feed's last, and that line
    stale_seen: list[Any] = [0.0, False]
    told_old: set[Any] = set()
    if sys.stdin.isatty() and sys.stdout.isatty():
        chat_mode().sink = []
        chat_mode().on = True
    import threading

    try:
        import readline
    except ImportError:
        readline = None  # type: ignore[assignment]
    config = load_config()
    participant(config, args.as_)
    if args.as_ in people_ids(config):
        begin_signing()
    known = ids_of(config)
    me = label_of(config, args.as_)
    tty = sys.stdout.isatty() and sys.stdin.isatty() and not args.plain

    # It signs only typed words, in the window the room opened for this person
    # («printf … | collab chat --as owner» got a signature). An agent could still start a chat in
    # a terminal and type into it — a higher bar, not a lock.
    def signs() -> bool:
        # At sending, not at start: the room writes down the chat's window only after opening it. From the
        # checked file: read by its path, a link put in its place decided whose window signs.
        with contextlib.redirect_stderr(io.StringIO()):  # its one line would land on the person's screen
            panes = read_panes().get("panes")
        own = panes.get(args.as_) if isinstance(panes, dict) else None
        return sys.stdin.isatty() and bool(own) and os.environ.get("TMUX_PANE") == own

    # A message to this person by name is shown whole: cut, its rest could not be read in the chat
    # at all («the message was cut — it's a bug»). Long ones to everyone (commit
    # reports) are still cut, so they don't flood the conversation.
    # One column short of the window, as the feed wraps: a line pretty made the window's full width
    # was cut again there, its last letter alone on the next line.
    # The window's width at each message, not at the start: with /dm opened beside it the chat is a third
    # narrower, and every long line's tail began at column 0 — where only a head begins.
    show = (
        (
            lambda m: feed_block(
                config, m, shutil.get_terminal_size((100, 24)).columns - 1, 0 if args.as_ in m.get("to", []) else args.max_lines
            )
        )
        if not args.plain
        else (lambda m: fmt(m, with_id=False, config=config))
    )
    names = aliases(config)

    def complete(text: str, state: int) -> str | None:
        options = address_candidates(config, args.as_, text) if text.startswith("@") else []
        return options[state] + " " if state < len(options) else None

    if readline is not None and tty:
        readline.set_completer(complete)
        readline.set_completer_delims(" ")
        # macOS Python is linked with libedit, which wants its own binding syntax.
        readline.parse_and_bind("bind ^I rl_complete" if "libedit" in (readline.__doc__ or "") else "tab: complete")
    lock = threading.RLock()
    printed = {m["id"] for m in read_messages()}
    stop = threading.Event()
    shown_state: dict[str, str] = {}
    ui.bar = ""
    ui.menu_line = ""

    if tty:
        prompt = tr("\u0001\u001b[1;{p0}m\u0002{me} ›\u0001\u001b[0m\u0002 ", p0=color_of(config, args.as_), me=me)
    else:
        prompt = f"{args.as_}> "

    ui.extra_rows = 0  # the status cells' rows beyond the first; everything else sits above them

    def rows() -> int:
        """The bottom row of the chat's own layout: the terminal's height less the extra status rows.
        A change here repaints the screen (pump), so the feed and the input move up by themselves."""
        return shutil.get_terminal_size((100, 24)).lines - ui.extra_rows

    feed_log: list[str] = []  # what the feed shows, to repaint it after a resize
    ui.viewing = None  # /view: {"pid", "pane", "label"} while an agent's screen is shown
    ui.reading = None  # /mine: {"ids", "at"} while one message is shown on its own
    # History («I can't scroll the chat up»; the mouse is off so text can be copied,
    # and a MacBook has no PgUp). The chat scrolls its own feed, one message per ↑/↓ («count
    # messages, not lines»); a message taller than the window goes in parts; Esc — the newest.
    # tmux's copy mode was tried: its arrows move a cursor first, and binding them would change
    # keys of the person's other tmux sessions.
    blocks: list[list[str]] = []  # the feed as it came: one entry per message or notice
    ui.top = None  # first line on screen while reading history; None — not reading
    ui.unseen = 0  # messages that came while the person reads history: shown on return
    ui.older = None  # index (in the room's messages) of the oldest one in the feed

    def feed(text: str, remember: bool = True) -> None:
        return chat_append(feed_context, text, remember)

    def draw_bottom() -> None:
        if not tty:
            return
        h, w = rows(), shutil.get_terminal_size((100, 24)).columns
        sys.stdout.write(bottom_frame(ui.menu_line, ui.bar, h, w))
        sys.stdout.flush()

    def setup() -> None:
        rp = room().paths
        if not tty:
            return
        # Name the pane once: an earlier version wrote states into the pane title, and tmux kept
        # that stale line above the panel after the chat stopped updating it.
        sys.stdout.write(f"\033]2;collab-room · {me}\033\\")
        border_title(tr("{room} · Room chat", room=rp.root.name.lstrip(".") or rp.root.name))
        h = rows()
        sys.stdout.write("\n" * 3 + f"\033[1;{h - 3}r")
        ui.laid = (h, shutil.get_terminal_size((100, 24)).columns)
        # The /dm panel beside it puts its rule and input on the chat's own rows («the
        # input and the output on one level»): it reads how many rows lie under the chat's rule.
        if os.environ.get("TMUX_PANE"):
            tmux("set-option", "-p", "-t", os.environ["TMUX_PANE"], "@collab_below", str(ui.extra_rows + 2), check=False)
        draw_bottom()
        sys.stdout.write(f"\033[{h - 1};1H\033[2K")
        sys.stdout.flush()

    def draw_view() -> None:
        v = ui.viewing
        if not v or not tty:
            return
        h, w = rows(), shutil.get_terminal_size((100, 24)).columns
        shot = tmux("capture-pane", "-e", "-p", "-t", v["pane"], check=False)
        out, ui.menu_line = view_frame(v["label"], shot.returncode, shot.stdout, h, w)
        sys.stdout.write(out)
        draw_bottom()

    def wrapped() -> tuple[list[str], list[int]]:
        """The feed's lines as the window shows them, and where each message starts among them."""
        return feed_lines(blocks, shutil.get_terminal_size((100, 24)).columns)

    def load_older() -> int:
        """Earlier messages from the room's log, when history reaches the top of what is shown:
        the chat starts with the latest ten, and its memory is not the room's whole history.
        Returns how many lines came in above."""
        if not ui.older:
            return 0
        before = len(wrapped()[0])
        start = max(0, ui.older - 20)
        new = [show(m).split("\n") for m in read_messages()[start : ui.older]]
        blocks[:0] = new
        feed_log[:0] = [line for block in new for line in block]
        ui.older = start
        return len(wrapped()[0]) - before

    def draw_history() -> None:
        if not tty or ui.top is None:
            return
        h = rows()
        area = max(1, h - 4)
        lines, _ = wrapped()
        sys.stdout.write(history_frame(lines, ui.top, area))
        ui.menu_line = history_label()
        draw_bottom()

    def history_label() -> str:
        return history_hint(ui.older, ui.top, ui.unseen, shutil.get_terminal_size((100, 24)).columns)

    def history(direction: int, page: bool = False) -> None:
        top = history_step(ui.top, max(1, rows() - 4), direction, page, wrapped, load_older, lambda: ui.older)
        if top is None:
            leave_history()
            return
        ui.top = top
        draw_history()

    def leave_history() -> None:
        ui.top = None
        ui.unseen = 0
        ui.menu_line = ""
        del feed_log[:-5000]
        del blocks[:-1000]
        repaint()

    def draw_reading() -> None:
        rp = room().paths
        r = ui.reading
        if not r or not tty:
            return
        h, w = rows(), shutil.get_terminal_size((100, 24)).columns
        out, menu, m = reading_frame(config, args.as_, rp.root, r, read_messages(), h, w, pretty)
        if m is not None:
            write_set(rp.receipts_dir, args.as_, read_set(rp.receipts_dir, args.as_) | {m["id"]})
        sys.stdout.write(out)
        ui.menu_line = menu
        count_mine()
        draw_bottom()

    def stop_reading() -> None:
        ui.reading = None
        ui.menu_line = ""
        repaint()
        run_wizard_step("/mine")  # back to the list, what is read is gone from it

    def open_dm(pid: str) -> None:
        """Open the panel beside this chat (or switch it) on a tab for `pid`; the focus goes there."""
        rp = room().paths
        state = dm_tabs(args.as_)
        set_dm_tabs(args.as_, state["tabs"] + ([pid] if pid not in state["tabs"] else []), pid)
        rec = dm_window(args.as_)
        if dm_window_alive(args.as_):
            tmux("select-pane", "-t", rec["pane"], check=False)
            return
        own = os.environ.get("TMUX_PANE", "")
        if not tty or not signs():
            say_ = lambda text: feed(paint(text, "38;5;252"))
            say_(tr("The private-talk panel opens only beside the person's own chat window."))
            set_dm_tabs(args.as_, [], "")
            return
        width = tmux("display-message", "-p", "-t", own, "#{pane_width}", check=False).stdout.strip()
        if not width.isdigit() or int(width) < 90:
            feed(
                paint(
                    tr("! The window is too narrow for a panel beside the chat — use /answer, or write here."),
                    "1;38;5;196",
                )
            )
            set_dm_tabs(args.as_, [], "")
            return
        # This chat's own interpreter, not `python3` from PATH: the panel signs only while its window's
        # process is itself, and a wrapper running Python as its child (no exec) left every private
        # word of the person marked ⚠.
        cmd = f"{shlex.quote(sys.executable)} {shlex.quote(SELF)} dm --as {shlex.quote(args.as_)}"
        out = tmux(
            "split-window",
            "-h",
            "-l",
            "33%",
            "-t",
            own,
            "-P",
            "-F",
            "#{pane_id} #{pane_pid}",
            "-c",
            tmux_dir(str(rp.root)),
            *pane_env(),
            in_dir(str(rp.root), cmd),
            check=False,
        )
        pane, _, ppid = out.stdout.strip().partition(" ")
        if out.returncode != 0 or not pane:
            feed(paint(tr("! Could not open the panel: {p0}", p0=out.stderr.strip()), "1;38;5;196"))
            set_dm_tabs(args.as_, [], "")
            return
        # Written by this chat alone, with the window's process: only that window signs as the person.
        remember_dm_window(args.as_, pane, ppid)
        # The border of the half where typing goes is bright — this window only, not the person's others.
        tmux("set-option", "-w", "-t", own, "pane-active-border-style", "fg=colour214", check=False)
        tmux("set-option", "-w", "-t", own, "pane-border-style", "fg=colour240", check=False)

    def close_dm() -> None:
        rec = dm_window(args.as_)
        set_dm_tabs(args.as_, [], "")
        if rec and dm_window_alive(args.as_):
            tmux("kill-pane", "-t", rec["pane"], check=False)
        forget_dm_window(args.as_)

    def stop_view() -> None:
        ui.viewing = None
        ui.menu_line = ""
        repaint()

    def repaint() -> None:
        """After a resize: clear, rebuild the fixed area for the new height and replay the end of
        the feed — the old screen was garbled and an open /add question was lost from view."""
        h = rows()
        sys.stdout.write(SYNC_ON + "\033[r\033[2J\033[H")  # one frame: render ends it (SYNC_OFF)
        setup()
        tail = feed_log[-max(1, h - 4) :]
        feed("\n".join(tail), remember=False)
        draw_bottom()
        if ui.top is not None:
            draw_history()
        ui.redraw_input()

    def stale_chat() -> bool:
        """collab on disk is no longer the one this chat runs (checked at most every 10 s)."""
        if time.time() - stale_seen[0] > 10:
            stale_seen[0] = time.time()
            with contextlib.suppress(OSError):
                stale_seen[1] = current_name() != born
        return stale_seen[1]

    def old_versions() -> list[str]:
        return chat_old_versions(feed_context)

    def states() -> list[str]:
        return chat_states(feed_context)

    def fold_into_dm(m: dict[str, Any]) -> bool:
        return chat_fold_into_dm(feed_context, m)

    def count_mine(messages: list[dict[str, Any]] | None = None) -> None:
        """«● N for you»: unread messages for the person and agents waiting for them right now. The feed
        passes the log it read this tick: read twice a tick, a long log cost twice."""
        rp = room().paths
        read = read_set(rp.receipts_dir, args.as_)
        st = read_status()
        messages = read_messages() if messages is None else messages
        # A quiet note is not counted: «● N for you» is what wakes the person.
        mine = [m for m in for_person(messages, args.as_) if m["id"] not in read and not is_quiet(m, config)]
        ui.mine_count = len(mine) + sum(
            1 for pid, x in st.items() if pid != args.as_ and pid in known and x.get("state") == "needs_owner"
        )

    held_alerts: list[str] = []

    def pump() -> None:
        return chat_pump(feed_context)

    if not tty:
        print(
            tr("collab-room as {as_}. Write `@id text` to address, plain text goes to all. Ctrl-D to leave.", as_=args.as_)
        )
    else:
        setup()
    speak(room_language(config))  # the chat speaks its room's language
    welcome = tty and not inst.welcomed_path.exists() and args.as_ in people_ids(config)
    feed_context = ChatFeedContext(
        STALE_CHAT=STALE_CHAT,
        args=args,
        blocks=blocks,
        config=config,
        count_mine=count_mine,
        dm_focus=dm_focus,
        dm_tabs=dm_tabs,
        dm_talk=dm_talk,
        dm_window_alive=dm_window_alive,
        draw_bottom=draw_bottom,
        draw_history=draw_history,
        draw_view=draw_view,
        feed=feed,
        feed_frame=feed_frame,
        feed_log=feed_log,
        fold_into_dm=fold_into_dm,
        folded=folded,
        held_alerts=held_alerts,
        known=known,
        lock=lock,
        me=me,
        names=names,
        old_versions=old_versions,
        printed=printed,
        refresh_people=lambda *a, **k: refresh_people(*a, **k),  # defined further down
        repaint=repaint,
        rows=rows,
        show=show,
        shown_state=shown_state,
        stale_chat=stale_chat,
        states=states,
        status_bar_rows=status_bar_rows,
        stop=stop,
        targets=lambda: targets,
        told_old=told_old,
        tty=tty,
        ui=ui,
        wizard=lambda: wizard,
    )
    if tty and not welcome:
        feed(HELP(me, ids=known, lang=room_language(config)))
    # The latest messages last, right above the input: under the guide they scrolled out of a
    # small window, and with the mouse off the reopened room looked empty.
    everything = read_messages()
    recent = everything[-10:]
    ui.older = len(everything) - len(recent)
    for m in recent:
        feed(show(m))
    if tty and recent and not welcome:
        feed(paint("  /help — the guide · ↑ — earlier messages (Esc — back)", "2"))
    if welcome:
        # First visit of this person (once per user, not per room): a short welcome and a
        # choice; nothing is sent and no agent is started by it. Last, above the choice: printed
        # before the latest messages it scrolled out of sight.
        feed(
            paint(
                tr(
                    "Welcome to your room\n  Write to your agents here.\n  Tab chooses who receives your message. Enter sends it.\n  Type / to choose an action. You don't need to remember commands.\n  Each agent works in a window of its own — you never need to go there:\n  /view shows its screen, /answer opens it to reply, Ctrl+] brings you back."
                ),
                "1;38;5;252",
            )
            + "\n" * 4
        )  # room for the choice under it: the menu is drawn over the feed's bottom
    for alert in states():
        feed("\n" + alert)
    with contextlib.suppress(Exception):
        mine_since(args.as_, start=True)
        count_mine()
    draw_bottom()

    # Recipients cycled with Tab / Shift+Tab («@ и Tab неудобно»): Всем first.
    targets = ["all"] + [pid for pid in known if pid != args.as_]
    ui.redraw_input = lambda: None  # set once the input line exists
    ui.selected = "all"  # the chosen id, not an index: survives participants joining
    wizard: dict[str, Any] = {}
    if welcome:
        wizard.update(
            step="welcome",
            prompt=tr("Welcome to your room"),
            options=[(tr("Show me around"), "tour"), (tr("Skip for now"), "skip")],
        )
    if tty and not welcome and args.as_ in people_ids(config) and offer_team(config):
        # A new room: «What will we do?» first — a ready team, or none (Esc, or «No ready team»).
        open_scenarios_into(wizard, room_language(config))
    if tty and args.as_ in people_ids(config) and name_asked(args.as_):
        # Named after the computer's account («Andreynaumov»): asked before anything else, the welcome after.
        mine = label_of(config, args.as_)
        wizard.update(
            step="own_name",
            then=dict(wizard),
            options=None,
            prompt=tr(
                "The room calls you {mine} — your account's name. Your name (Enter keeps {mine_}):", mine=mine, mine_=mine
            ),
        )
        feed("\n" + wizard["prompt"])
    ui.cfg_mtime = rp.config_path.stat().st_mtime if rp.config_path.exists() else 0.0

    def refresh_people() -> bool:
        return chat_refresh_people(feed_context)

    def step(delta: int) -> None:
        if ui.selected not in targets:
            ui.selected = targets[0]
            return
        i = targets.index(ui.selected)
        ui.selected = targets[(i + delta) % len(targets)]

    holder = {"config": config}

    def add_wizard(line: str) -> None:
        return chat_add_wizard(command_context, line)

    def wizard_back() -> None:
        return chat_wizard_back(command_context)

    def ask_exit() -> None:
        return chat_ask_exit(command_context)

    def stay_open() -> None:
        return chat_stay_open(command_context)

    def show_folders(cur: Path) -> None:
        return chat_show_folders(command_context, cur)

    def run_wizard_step(line: str) -> None:
        return chat_run_wizard_step(command_context, line)

    def submit(line: str) -> None:
        return chat_submit(command_context, line)

    def handle(line: str) -> None:
        return chat_handle(command_context, line)

    command_context = ChatCommandContext(
        add_wizard=add_wizard,
        after_key=lambda: after_lock,
        args=args,
        blocks=blocks,
        buffer=lambda: buf,
        clipboard=copy_to_clipboard,
        close_dm=close_dm,
        commands=lambda: COMMANDS,
        config=config,
        count_mine=count_mine,
        draw_reading=draw_reading,
        draw_view=draw_view,
        feed=feed,
        feed_log=feed_log,
        format_message=pretty,
        handle=handle,
        help_tasks=HELP_TASKS,
        help_text=HELP,
        holder=holder,
        known=known,
        lock=lock,
        me=me,
        menu_items=lambda: menu_items(),
        names=names,
        open_dm=open_dm,
        people_for=lambda cmd: people_for(cmd),
        printed=printed,
        refresh_people=refresh_people,
        repaint=repaint,
        run_wizard_step=run_wizard_step,
        show=show,
        show_folders=show_folders,
        signs=signs,
        stale_chat=stale_chat,
        stale_notice=STALE_CHAT,
        stay_open=stay_open,
        submit=submit,
        tty=tty,
        ui=ui,
        whole_line=WHOLE,
        wizard=wizard,
        wizard_back=wizard_back,
    )

    ui.popup = 0  # how many popup rows are drawn over the feed now
    # The feed's thread starts only now, when all it reads is there: started before, its first tick could
    # come before `popup`, `wizard`, `refresh_people`… — a NameError ended the feed for good, the input
    # still sending; without a terminal it came every time, `popup` being set only further down.
    threading.Thread(target=pump, daemon=True).start()
    if not tty:
        while True:
            try:
                line = input(prompt)
            except (EOFError, KeyboardInterrupt):
                print()
                return
            try:
                submit(line)
            except EOFError:
                return

    import termios
    import tty as ttymod

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    ttymod.setcbreak(fd)
    # Ctrl+C comes as a key, not a signal: it asks before closing («спрашивать») —
    # one press used to close the chat at once, also when meant as «copy».
    attrs = termios.tcgetattr(fd)
    attrs[3] &= ~termios.ISIG
    # Ctrl+O is a key too (to the /dm panel): macOS's terminal driver took it as «discard output»
    # and the chat never saw it. No extended input processing — Ctrl+V/Ctrl+O come through as keys.
    attrs[3] &= ~termios.IEXTEN
    termios.tcsetattr(fd, termios.TCSANOW, attrs)
    # Bracketed paste: a pasted block arrives as one message. A blinking bar shows which half the
    # typing goes to, with a /dm panel beside («I can't see which chat I'm in»).
    sys.stdout.write("\033[?2004h" + CURSOR_BLINK)
    buf: list[str] = []
    ui.pos = 0
    ui.menu_index = 0
    ui.menu_closed = False
    ui.menu_moved = False
    ui.suggested = False  # the draft is a suggested name: typing replaces it, ← → edit it
    ui.came_back = False  # Esc just stepped back from a command's menu to «/»
    after_lock: list[Any] = []  # what runs once a key is handled, without the chat's lock (the popup)
    # The menu's order; each shown in the room's language when the menu is drawn (chat_cmds.chat_menu_items).
    COMMANDS = [
        (c, words_in(f"cmd.{c[1:]}", "en"))
        for c in (
            "/add", "/remove", "/mute", "/unmute", "/unlimit", "/name", "/view", "/answer", "/open", "/pause",
            "/resume", "/clear", "/help", "/mine", "/dm", "/restart", "/team", "/telegram", "/language", "/stop", "/exit",
        )
    ]  # fmt: skip
    slash_commands = tuple(c for c, _ in COMMANDS) + tuple(shown_command(c, "ru") for c, _ in COMMANDS)

    def people_for(cmd: str) -> list[str]:
        return chat_people_for(command_context, cmd)

    def menu_items() -> list[tuple[str, str, str]]:
        return chat_menu_items(command_context)

    def command_matches() -> list[tuple[str, str, str]]:
        return chat_command_matches(command_context)

    def choose_command() -> str | None:
        return chat_choose_command(command_context)

    def render() -> None:
        return chat_render(menu_context)

    menu_context = ChatMenuContext(
        args=args,
        buf=buf,
        config=config,
        dm_focus=dm_focus,
        draw_bottom=draw_bottom,
        draw_reading=draw_reading,
        feed_log=feed_log,
        history_label=history_label,
        menu_items=menu_items,
        repaint=repaint,
        rows=rows,
        ui=ui,
        wizard=wizard,
    )

    ui.redraw_input = render
    with lock:
        render()
    input_context = ChatInputContext(
        after_lock=after_lock,
        args=args,
        ask_exit=ask_exit,
        buf=buf,
        choose_command=choose_command,
        commands=COMMANDS,
        dm_window=dm_window,
        dm_window_alive=dm_window_alive,
        draw_reading=draw_reading,
        fd=fd,
        feed=feed,
        history=history,
        leave_history=leave_history,
        lock=lock,
        menu_items=menu_items,
        render=render,
        repaint=repaint,
        slash_commands=slash_commands,
        step=step,
        stop_reading=stop_reading,
        stop_view=stop_view,
        submit=submit,
        ui=ui,
        wizard=wizard,
        wizard_back=wizard_back,
    )
    try:
        chat_read_keys(input_context)
    except KeyboardInterrupt:
        return
    finally:
        stop.set()
        with contextlib.suppress(Exception):
            close_dm()  # the panel closes with the chat
        if tty:
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, saved)
            except Exception:
                pass
            sys.stdout.write("\033[?2004l\033[r" + CURSOR_PLAIN + f"\033[{rows()};1H\n")
            sys.stdout.flush()
            leave_the_room_window()


def run_chat(args: argparse.Namespace) -> None:
    """The person's chat, with why it ended written to .collab/chat-exit.log: once both
    of the person's chats vanished and nothing could tell why. A window closed by tmux
    (SIGHUP) or a kill (SIGTERM) ends it like /exit does — the terminal is restored — and says so."""
    import signal
    import traceback

    def ended(reason: str) -> None:
        rp = room().paths
        try:
            write_state(
                rp.state_dir / "chat-exit.log",
                tr("{p0} {as_} pid {p2}: {reason}\n", p0=now(), as_=args.as_, p2=os.getpid(), reason=reason),
                append=True,
            )
        except (OSError, SystemExit, OperationFailed):
            pass  # the log must never be why the chat fails

    def on_signal(number: int, _frame: Any) -> None:
        raise SystemExit(tr("signal {name}", name=signal.Signals(number).name))

    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, on_signal)
    code: Any = 0
    try:
        cmd_chat(args)
        ended(tr("closed: /exit, Ctrl+C or end of input"))
    except SystemExit as exc:
        ended(str(exc.code) if isinstance(exc.code, str) else tr("exit code {code}", code=exc.code))
        code = exc.code
    except BaseException:
        ended("crashed:\n" + traceback.format_exc())
        with contextlib.suppress(OSError, ValueError):
            traceback.print_exc()
        code = 1

    # Not through the interpreter's own end: the feed thread may be inside a write to the terminal
    # just then (a busy tmux reads it late), holding stdout — and Python aborted, «Python quit
    # unexpectedly» on the person's screen six times in a day. What is left is written
    # out if it can be in a moment, and the chat ends there.
    def flush() -> None:
        with contextlib.suppress(OSError, ValueError):
            sys.stdout.flush()
            sys.stderr.flush()

    if isinstance(code, str):
        with contextlib.suppress(OSError, ValueError):
            print(code, file=sys.stderr)
    flushing = threading.Thread(target=flush, daemon=True)
    flushing.start()
    flushing.join(1.0)
    os._exit(code if isinstance(code, int) else (0 if code is None else 1))

